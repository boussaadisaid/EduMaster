<Application x:Class="EduMaster.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EduMaster.UI"
             xmlns:years="clr-namespace:EduMaster.UI.AcademicYears"
             xmlns:dialogs="clr-namespace:EduMaster.UI.Dialogs"
             xmlns:people="clr-namespace:EduMaster.UI.People"
             xmlns:students="clr-namespace:EduMaster.UI.Students"
             xmlns:teachers="clr-namespace:EduMaster.UI.Teachers"
             xmlns:academic="clr-namespace:EduMaster.UI.Academic"
             xmlns:classgroups="clr-namespace:EduMaster.UI.ClassGroups"
             xmlns:pricing="clr-namespace:EduMaster.UI.Pricing"
             xmlns:enrollments="clr-namespace:EduMaster.UI.Enrollments"
             xmlns:scheduling="clr-namespace:EduMaster.UI.Scheduling"
             xmlns:billing="clr-namespace:EduMaster.UI.Billing"
             xmlns:employees="clr-namespace:EduMaster.UI.Employees"
             xmlns:payroll="clr-namespace:EduMaster.UI.Payroll"
             xmlns:reports="clr-namespace:EduMaster.UI.Reports"
             xmlns:common="clr-namespace:EduMaster.UI.Common">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MahApps core -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml"/>
                <!-- Theme -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml"/>

                <ResourceDictionary Source="pack://application:,,,/ToastNotifications.Messages;component/Themes/Default.xaml" />

                <!-- F7: اللغة البصرية المشتركة (الشريط الجانبي/البطاقات/الأزرار) — تُدمج بعد MahApps لتبني عليه -->
                <ResourceDictionary Source="Themes/EduStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type ui:HomeViewModel}">
                <ui:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type years:AcademicYearsViewModel}">
                <years:AcademicYearsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type years:AcademicYearEditorViewModel}">
                <years:AcademicYearEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:ConfirmDialogViewModel}">
                <dialogs:ConfirmDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type people:PeopleViewModel}">
                <people:PeopleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type people:PersonEditorViewModel}">
                <people:PersonEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type people:CreateAccountViewModel}">
                <people:CreateAccountView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type people:ResetPasswordViewModel}">
                <people:ResetPasswordView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type people:ChangePasswordViewModel}">
                <people:ChangePasswordView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type students:StudentsViewModel}">
                <students:StudentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type students:StudentEditorViewModel}">
                <students:StudentEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type students:AssignStudentRoleViewModel}">
                <students:AssignStudentRoleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type teachers:TeachersViewModel}">
                <teachers:TeachersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type teachers:TeacherEditorViewModel}">
                <teachers:TeacherEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type teachers:AssignTeacherRoleViewModel}">
                <teachers:AssignTeacherRoleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type academic:AcademicStructureViewModel}">
                <academic:AcademicStructureView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type academic:LevelEditorViewModel}">
                <academic:LevelEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type academic:StreamEditorViewModel}">
                <academic:StreamEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type academic:SubjectEditorViewModel}">
                <academic:SubjectEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type academic:RoomEditorViewModel}">
                <academic:RoomEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type classgroups:ClassGroupsViewModel}">
                <classgroups:ClassGroupsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type classgroups:ClassGroupEditorViewModel}">
                <classgroups:ClassGroupEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type classgroups:ClassGroupRosterDialogViewModel}">
                <classgroups:ClassGroupRosterDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type classgroups:TransferGroupEnrollmentViewModel}">
                <classgroups:TransferGroupEnrollmentView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pricing:SubjectPriceEditorViewModel}">
                <pricing:SubjectPriceEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type enrollments:AnnualEnrollmentEditorViewModel}">
                <enrollments:AnnualEnrollmentEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type enrollments:EnrollInGroupDialogViewModel}">
                <enrollments:EnrollInGroupDialogView />
            </DataTemplate>
            <!-- Enrollments (F6 — الشريحة 6.2): ديالوغ الترحيل الجماعي — ✔ سطر التحقق -->
            <DataTemplate DataType="{x:Type enrollments:RolloverDialogViewModel}">
                <enrollments:RolloverDialogView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type scheduling:TimetableViewModel}">
                <scheduling:TimetableView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type scheduling:SessionsViewModel}">
                <scheduling:SessionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type scheduling:ScheduleSlotEditorViewModel}">
                <scheduling:ScheduleSlotEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type scheduling:GenerateSessionsDialogViewModel}">
                <scheduling:GenerateSessionsDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type scheduling:AdHocSessionViewModel}">
                <scheduling:AdHocSessionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type scheduling:PurchaseSessionsDialogViewModel}">
                <scheduling:PurchaseSessionsDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type scheduling:SessionAttendanceDialogViewModel}">
                <scheduling:SessionAttendanceDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type scheduling:CorrectSessionTeacherDialogViewModel}">
                <scheduling:CorrectSessionTeacherDialogView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type billing:ChargeSettlementDialogViewModel}">
                <billing:ChargeSettlementDialogView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type billing:PaymentDialogViewModel}">
                <billing:PaymentDialogView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type billing:FinanceViewModel}">
                <billing:FinanceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type billing:RefundDialogViewModel}">
                <billing:RefundDialogView />
            </DataTemplate>

            <!-- Employees (F5 — دفعة B-1) -->
            <DataTemplate DataType="{x:Type employees:EmployeesViewModel}">
                <employees:EmployeesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type employees:EmployeeEditorViewModel}">
                <employees:EmployeeEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type employees:AssignEmployeeRoleViewModel}">
                <employees:AssignEmployeeRoleView />
            </DataTemplate>

            <!-- Payroll (F5 — دفعة B-2) — ✔ سطر التحقق -->
            <DataTemplate DataType="{x:Type payroll:PayPolicyDialogViewModel}">
                <payroll:PayPolicyDialogView />
            </DataTemplate>
            <!-- Payroll (F5 — الشريحة 5.2): شاشة «💼 الأجور» — جديد هـ-2 -->
            <DataTemplate DataType="{x:Type payroll:PayrollRunsViewModel}">
                <payroll:PayrollRunsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type payroll:PayoutDialogViewModel}">
                <payroll:PayoutDialogView />
            </DataTemplate>

            <!-- Reports (F6 — الشريحة 6.1) — ✔ سطر التحقق: القسم بثلاثة -->
            <DataTemplate DataType="{x:Type reports:ReportsViewModel}">
                <reports:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type reports:PaymentMovementReportViewModel}">
                <reports:PaymentMovementReportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type reports:StudentStatementViewModel}">
                <reports:StudentStatementView />
            </DataTemplate>
            <!-- Reports (F6 — الشريحة 6.4: ق-ب) — ✔ سطر التحقق: القسم بثلاثة -->
            <DataTemplate DataType="{x:Type reports:AttendanceSummaryReportViewModel}">
                <reports:AttendanceSummaryReportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type reports:GroupSessionsReportViewModel}">
                <reports:GroupSessionsReportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type reports:LowSessionBalancesViewModel}">
                <reports:LowSessionBalancesView />
            </DataTemplate>

            <!-- Custom Font (make sure Cairo.ttf is in /Fonts folder) -->
            <FontFamily x:Key="CairoFont">pack://application:,,,/Fonts/#Cairo</FontFamily>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <common:CentimesToDinarsConverter x:Key="CentimesToDinarsConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
