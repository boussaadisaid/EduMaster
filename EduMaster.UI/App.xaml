<Application x:Class="EduMaster.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EduMaster.UI"
             xmlns:years="clr-namespace:EduMaster.UI.AcademicYears"
             xmlns:dialogs="clr-namespace:EduMaster.UI.Dialogs"
             xmlns:people="clr-namespace:EduMaster.UI.People"
             xmlns:students="clr-namespace:EduMaster.UI.Students"
             xmlns:teachers="clr-namespace:EduMaster.UI.Teachers"
             xmlns:academic="clr-namespace:EduMaster.UI.Academic"
             xmlns:classgroups="clr-namespace:EduMaster.UI.ClassGroups"
             xmlns:pricing="clr-namespace:EduMaster.UI.Pricing"
             xmlns:common="clr-namespace:EduMaster.UI.Common">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MahApps core -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml"/>
                <!-- Theme -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml"/>

                <ResourceDictionary Source="pack://application:,,,/ToastNotifications.Messages;component/Themes/Default.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <DataTemplate DataType="{x:Type ui:HomeViewModel}">
                <ui:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type years:AcademicYearsViewModel}">
                <years:AcademicYearsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type years:AcademicYearEditorViewModel}">
                <years:AcademicYearEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:ConfirmDialogViewModel}">
                <dialogs:ConfirmDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type people:PeopleViewModel}">
                <people:PeopleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type people:PersonEditorViewModel}">
                <people:PersonEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type people:CreateAccountViewModel}">
                <people:CreateAccountView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type people:ResetPasswordViewModel}">
                <people:ResetPasswordView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type people:ChangePasswordViewModel}">
                <people:ChangePasswordView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type students:StudentsViewModel}">
                <students:StudentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type students:StudentEditorViewModel}">
                <students:StudentEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type teachers:TeachersViewModel}">
                <teachers:TeachersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type teachers:TeacherEditorViewModel}">
                <teachers:TeacherEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type students:AssignStudentRoleViewModel}">
                <students:AssignStudentRoleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type teachers:AssignTeacherRoleViewModel}">
                <teachers:AssignTeacherRoleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type academic:AcademicStructureViewModel}">
                <academic:AcademicStructureView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type academic:LevelEditorViewModel}">
                <academic:LevelEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type academic:StreamEditorViewModel}">
                <academic:StreamEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type academic:SubjectEditorViewModel}">
                <academic:SubjectEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type academic:RoomEditorViewModel}">
                <academic:RoomEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type classgroups:ClassGroupsViewModel}">
                <classgroups:ClassGroupsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type classgroups:ClassGroupEditorViewModel}">
                <classgroups:ClassGroupEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pricing:SubjectPriceEditorViewModel}">
                <pricing:SubjectPriceEditorView />
            </DataTemplate>
            <!-- Custom Font (make sure Cairo.ttf is in /Fonts folder) -->
            <FontFamily x:Key="CairoFont">pack://application:,,,/Fonts/#Cairo</FontFamily>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <common:CentimesToDinarsConverter x:Key="CentimesToDinarsConverter"/>
            <!--  سطر التحقق — بدونه تنهار شاشة البنية الأكاديمية -->
        </ResourceDictionary>
    </Application.Resources>
</Application>