<UserControl x:Class="EduMaster.UI.Academic.AcademicStructureView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft">
    <UserControl.Resources>
        <Style x:Key="StatusCell" TargetType="TextBlock">
            <Setter Property="Text" Value="فعّال"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Text" Value="معطّل"/>
                    <Setter Property="Foreground" Value="Gray"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="البنية الأكاديمية" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <TabControl Grid.Row="1">

            <!-- التبويب 1: المستويات والشعب (Master-Detail كامل العرض) -->
            <TabItem Header="المستويات والشعب">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- المستويات -->
                    <Grid Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="المستويات الدراسية" FontWeight="SemiBold" FontSize="15"/>
                        <DataGrid Grid.Row="1" Margin="0,8,0,0"
                                  ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="الترتيب" Binding="{Binding SortOrder}" Width="*"/>
                                <DataGridTemplateColumn Header="الحالة" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource StatusCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="➕ مستوى جديد" Command="{Binding AddLevelCommand}"        Padding="16,6" Margin="0,0,8,0"/>
                            <Button Content="✏️ تعديل"      Command="{Binding EditLevelCommand}"       Padding="16,6" Margin="0,0,8,0"/>
                            <Button Content="🚫 تعطيل"      Command="{Binding DeactivateLevelCommand}" Padding="16,6" Margin="0,0,8,0"/>
                            <Button Content="✔ تفعيل"       Command="{Binding ActivateLevelCommand}"   Padding="16,6"/>
                        </StackPanel>
                    </Grid>

                    <!-- الشعب — تتبع المستوى المحدد -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding SelectedLevel.Name, StringFormat='شعب: {0}', TargetNullValue='شعب المستوى المحدد'}"
                                   FontWeight="SemiBold" FontSize="15"/>
                        <DataGrid Grid.Row="1" Margin="0,8,0,0"
                                  ItemsSource="{Binding Streams}" SelectedItem="{Binding SelectedStream}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTemplateColumn Header="الحالة" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource StatusCell}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="➕ شعبة جديدة" Command="{Binding AddStreamCommand}"        Padding="16,6" Margin="0,0,8,0"/>
                            <Button Content="✏️ تعديل"      Command="{Binding EditStreamCommand}"       Padding="16,6" Margin="0,0,8,0"/>
                            <Button Content="🚫 تعطيل"      Command="{Binding DeactivateStreamCommand}" Padding="16,6" Margin="0,0,8,0"/>
                            <Button Content="✔ تفعيل"       Command="{Binding ActivateStreamCommand}"   Padding="16,6"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- التبويب 2: المواد -->
            <TabItem Header="المواد">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="المواد" FontWeight="SemiBold" FontSize="15"/>
                    <DataGrid Grid.Row="1" Margin="0,8,0,0"
                              ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTemplateColumn Header="الحالة" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource StatusCell}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="➕ مادة جديدة" Command="{Binding AddSubjectCommand}"        Padding="16,6" Margin="0,0,8,0"/>
                        <Button Content="✏️ تعديل"     Command="{Binding EditSubjectCommand}"       Padding="16,6" Margin="0,0,8,0"/>
                        <Button Content="🚫 تعطيل"     Command="{Binding DeactivateSubjectCommand}" Padding="16,6" Margin="0,0,8,0"/>
                        <Button Content="✔ تفعيل"      Command="{Binding ActivateSubjectCommand}"   Padding="16,6"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- التبويب 3: القاعات -->
            <TabItem Header="القاعات">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="القاعات" FontWeight="SemiBold" FontSize="15"/>
                    <DataGrid Grid.Row="1" Margin="0,8,0,0"
                              ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="السعة" Binding="{Binding Capacity, TargetNullValue='—'}" Width="*"/>
                            <DataGridTemplateColumn Header="الحالة" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource StatusCell}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="➕ قاعة جديدة" Command="{Binding AddRoomCommand}"        Padding="16,6" Margin="0,0,8,0"/>
                        <Button Content="✏️ تعديل"     Command="{Binding EditRoomCommand}"       Padding="16,6" Margin="0,0,8,0"/>
                        <Button Content="🚫 تعطيل"     Command="{Binding DeactivateRoomCommand}" Padding="16,6" Margin="0,0,8,0"/>
                        <Button Content="✔ تفعيل"      Command="{Binding ActivateRoomCommand}"   Padding="16,6"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>