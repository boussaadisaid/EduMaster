<UserControl x:Class="EduMaster.UI.Payroll.PayoutDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls" FlowDirection="RightToLeft" Width="760" Height="650">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="22,20,22,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="50" Height="50" CornerRadius="25" Background="{StaticResource PositiveSoftBrush}" Margin="0,0,12,0">
                    <TextBlock Text="💵" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderText}" Style="{StaticResource EduSectionTitle}"/>
                    <TextBlock Text="تسجيل صرف موثّق ومتابعة الرصيد والإيصالات" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,10">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14" Visibility="{Binding IsPayeePickerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="اختيار المستفيد" Style="{StaticResource EduSubsectionTitle}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,0">
                                <TextBlock Text="الصفة" Style="{StaticResource EduFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PickerKindOptions}" SelectedItem="{Binding SelectedPickerKind}" DisplayMemberPath="Label" Height="40" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="المستفيد" Style="{StaticResource EduFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PickerPayeeOptions}" SelectedItem="{Binding SelectedPickerPayee}" DisplayMemberPath="Name" Height="40" Padding="10,6" Controls:TextBoxHelper.Watermark="اختر المستفيد…"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="الرصيد الجاري" Style="{StaticResource EduSubsectionTitle}"/>
                        <Border Background="#F7F9FC" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,10,0,16">
                            <TextBlock Text="{Binding BreakdownText}" Style="{StaticResource EduBodyStrong}" TextWrapping="Wrap"/>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="المبلغ بالدينار *" Style="{StaticResource EduFieldLabel}"/>
                                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="المعاينة بعد الصرف" Style="{StaticResource EduFieldLabel}"/>
                                <Border CornerRadius="8" Padding="12,9" MinHeight="40">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EEF5FC"/>
                                            <Setter Property="BorderBrush" Value="#D5E5F4"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdvance}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                    <Setter Property="BorderBrush" Value="#E9D7A5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAdvance}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style></TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding NoteHeaderText}" Style="{StaticResource EduFieldLabel}" Margin="0,14,0,0"/>
                        <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                        </Grid.RowDefinitions>
                        <Border Padding="16,12" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="الإيصالات السابقة" Style="{StaticResource EduSubsectionTitle}"/>
                                    <TextBlock Text="حدد إيصالاً أصلياً عند الحاجة إلى قيد تصحيح عكسي" Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="تصحيح المحدد" Command="{Binding CorrectCommand}" Style="{StaticResource SecondaryButton}" Padding="14,7"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <DataGrid ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" VerticalGridLinesBrush="Transparent" BorderThickness="0" RowHeight="42" ColumnHeaderHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم الإيصال" Binding="{Binding ReceiptNo}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="المبلغ" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AmountCentimes, Converter={StaticResource CentimesToDinarsConverter}}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCorrection}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource NegativeBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style></TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAtUtc, StringFormat='yyyy-MM-dd'}" Width="Auto"/>
                                    <DataGridTextColumn Header="الملاحظة" Binding="{Binding Note, TargetNullValue='—'}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ReceiptsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="🧾" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="لا توجد إيصالات سابقة" Style="{StaticResource EduBodyMuted}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="تسجيل الصرف" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="20,9" Margin="0,0,8,0"/>
                <Button Content="إغلاق" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" Padding="20,9"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>