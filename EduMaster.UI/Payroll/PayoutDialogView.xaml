<UserControl x:Class="EduMaster.UI.Payroll.PayoutDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        FlowDirection="RightToLeft">
    <Border Background="White" Padding="22,18" MinWidth="580">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding HeaderText}" FontSize="18" FontWeight="SemiBold"/>

            <!-- منتقي المستفيد — وضع السلفة الحرة فقط (لمن لا حضور مالي له بعد) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0"
                        Visibility="{Binding IsPayeePickerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ComboBox ItemsSource="{Binding PickerKindOptions}" SelectedItem="{Binding SelectedPickerKind}"
                          DisplayMemberPath="Label" Width="90"/>
                <ComboBox ItemsSource="{Binding PickerPayeeOptions}" SelectedItem="{Binding SelectedPickerPayee}"
                          DisplayMemberPath="Name" MinWidth="200" Margin="8,0,0,0"
                          Controls:TextBoxHelper.Watermark="اختر المستفيد…"/>
            </StackPanel>

            <!-- التفكيك الحي للرصيد الجاري (الترحيل تلقائي) -->
            <Border Grid.Row="2" Background="#F7F9FC" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,10,0,0">
                <TextBlock Text="{Binding BreakdownText}" FontSize="13" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="المبلغ (دج) *" Margin="0,0,0,4"/>
                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="14"/>
                <TextBlock Text="{Binding PreviewText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Gray"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdvance}" Value="True">
                                    <Setter Property="Foreground" Value="#B26A00"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding NoteHeaderText}" Margin="0,10,0,4"/>
                <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
            </StackPanel>

            <!-- سجل الإيصالات + التصحيح العكسي -->
            <StackPanel Grid.Row="4" Margin="0,14,0,0">
                <DockPanel>
                    <Button Content="↩ تصحيح المحدد" Command="{Binding CorrectCommand}"
                            DockPanel.Dock="Left" Padding="10,4" FontSize="12"/>
                    <TextBlock Text="الإيصالات السابقة" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid Margin="0,6,0,0" Height="130"
                          ItemsSource="{Binding Receipts}"
                          SelectedItem="{Binding SelectedReceipt}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم" Binding="{Binding ReceiptNo}" Width="Auto"/>
                        <DataGridTemplateColumn Header="المبلغ" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AmountCentimes, Converter={StaticResource CentimesToDinarsConverter}}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCorrection}" Value="True">
                                                        <Setter Property="Foreground" Value="#C42B1C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAtUtc, StringFormat='yyyy-MM-dd'}" Width="Auto"/>
                        <DataGridTextColumn Header="الملاحظة" Binding="{Binding Note, TargetNullValue='—'}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="لا إيصالات سابقة لهذا المستفيد"
                           Foreground="Gray" FontSize="12" HorizontalAlignment="Center" Margin="0,-90,0,0"
                           Visibility="{Binding ReceiptsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- التذييل المثبّت (D-41) -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="💾 سجّل الصرف" Command="{Binding SaveCommand}" Padding="18,8" FontWeight="SemiBold"/>
                <Button Content="إغلاق" Command="{Binding CloseCommand}" Padding="18,8" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>