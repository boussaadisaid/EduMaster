<UserControl x:Class="EduMaster.UI.Payroll.PayPolicyDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- قائمة السياسات -->
            <RowDefinition Height="Auto"/>
            <!-- المحرر المضمّن: يُمرَّر -->
            <RowDefinition Height="*"/>
            <!-- التذييل: مثبّت دائماً (D-41) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding PayeeName, StringFormat='سياسات الأجر لـ: {0}'}"
                   FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>

        <!-- قائمة سياسات المستفيد -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid ItemsSource="{Binding Policies}"
                      SelectedItem="{Binding SelectedPolicy}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Height="170">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="النطاق" Binding="{Binding ScopeText}" Width="*"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding KindText}" Width="*"/>
                    <DataGridTextColumn Header="القيمة" Binding="{Binding ValueText}" Width="*"/>
                    <DataGridTextColumn Header="الغياب" Binding="{Binding FlagText}" Width="*"/>
                    <DataGridTemplateColumn Header="الحالة" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="فعّالة"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Text" Value="معطّلة"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="لا سياسات بعد — أنشئ أول سياسة من الأسفل"
                       Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="✏️ تعديل" Command="{Binding EditPolicyCommand}" Padding="14,6" Margin="0,0,8,0"/>
                <Button Command="{Binding ToggleActiveCommand}" Padding="14,6">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="✔ تفعيل"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPolicy.IsActive}" Value="True">
                                    <Setter Property="Content" Value="🚫 تعطيل"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- المحرر المضمّن: إنشاء أو تعديل المحدد -->
        <Border Grid.Row="2" Background="#F7F9FC" BorderBrush="#D5DEEA" BorderThickness="1"
                CornerRadius="6" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="210">
                <StackPanel MinWidth="600">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="النوع *" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding KindOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedKind}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,0,10"
                                    Visibility="{Binding IsTeacher, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="النطاق *" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ScopeOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedScope}"
                                      IsEnabled="{Binding IsCreateMode}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,10"
                                    Visibility="{Binding IsRateKind, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="القيمة (دج) *" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,0,10"
                                    Visibility="{Binding IsPercentageKind, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="النسبة (%) *" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding PercentageText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="يُحتسب الغياب غير المبرر في الأجر (D-114)"
                              IsChecked="{Binding CountsUnjustifiedAbsent}" Margin="0,0,0,10"
                              Visibility="{Binding IsTeacher, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="💾 حفظ السياسة" Command="{Binding SaveCommand}"
                                Padding="18,7" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <Button Content="➕ سياسة جديدة" Command="{Binding NewCommand}" Padding="18,7"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- التذييل المثبّت: البانر + الإغلاق -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إغلاق" Command="{Binding CloseCommand}" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>