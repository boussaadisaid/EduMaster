<UserControl x:Class="EduMaster.UI.Payroll.PayrollRunsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        FlowDirection="RightToLeft">
    <Grid Margin="28">
        <TabControl SelectedIndex="{Binding SelectedTabIndex}">

            <!-- التبويب الأول: الكشوف -->
            <TabItem Header="📋 الكشوف">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="430"/>
                    </Grid.ColumnDefinitions>

                    <!-- العمود الأيمن: الكشوف -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,14">
                            <Button Content="🔄 تحديث" Command="{Binding RefreshCommand}"
                                    DockPanel.Dock="Left" Padding="14,6"/>
                            <TextBlock Text="💼 الأجور — الكشوف" FontSize="24" FontWeight="SemiBold"/>
                        </DockPanel>

                        <!-- توليد كشف جديد — الافتراضي الشهر الميلادي الحالي (س-1) -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="الفترة من" VerticalAlignment="Center"/>
                            <DatePicker SelectedDate="{Binding NewFrom}" Margin="6,0,12,0"/>
                            <TextBlock Text="إلى" VerticalAlignment="Center"/>
                            <DatePicker SelectedDate="{Binding NewTo}" Margin="6,0,12,0"/>
                            <Button Content="⚙ توليد مسودة" Command="{Binding GenerateCommand}" Padding="16,6" FontWeight="SemiBold"/>
                        </StackPanel>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Runs}"
                                  SelectedItem="{Binding SelectedRun}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الفترة" Binding="{Binding PeriodText}" Width="*"/>
                                <DataGridTemplateColumn Header="الحالة" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="مسودة"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDraft}" Value="False">
                                                                <Setter Property="Text" Value="معتمد"/>
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                                <DataGridTextColumn Header="السطور" Binding="{Binding LinesCount}" Width="Auto"/>
                                <DataGridTextColumn Header="اعتُمد" Binding="{Binding ApprovedAtUtc, StringFormat='yyyy-MM-dd', TargetNullValue='—'}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Text="لا كشوف بعد — حدّد الفترة واضغط «⚙ توليد مسودة» لأول كشف"
                                   Foreground="Gray" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Grid.Row="2" Text="جارٍ التحميل…" Foreground="Gray"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="🔁 إعادة الحساب" Command="{Binding RegenerateCommand}" Padding="14,6" Margin="0,0,8,0"/>
                            <Button Content="✅ اعتماد نهائي"   Command="{Binding ApproveCommand}"    Padding="14,6" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <Button Content="🗑 حذف المسودة"   Command="{Binding DeleteRunCommand}"   Padding="14,6"/>
                        </StackPanel>
                    </Grid>

                    <!-- العمود الأيسر: تفاصيل الكشف المحدد (مرآة لوحة الطالب D-70) -->
                    <Border Grid.Column="1" Margin="16,0,0,0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding SelectedRun.PeriodText, StringFormat='سطور الكشف: {0}', TargetNullValue='سطور الكشف'}"
                                       FontWeight="SemiBold" FontSize="15"/>

                            <!-- تحذيرات الاحتساب — تظهر بعد التوليد/إعادة الحساب مباشرة -->
                            <Border Grid.Row="1" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="4"
                                    Padding="8,6" Margin="0,8,0,0"
                                    Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="⚠ حصص بلا سياسة مغطية — لم تدخل الكشف:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Warnings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="#6D4C00"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <DataGrid Grid.Row="2" Margin="0,8,0,0"
                                      ItemsSource="{Binding RunLines}"
                                      SelectedItem="{Binding SelectedLine}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" SelectionMode="Single"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="المستفيد" Binding="{Binding PayeeName}" Width="*"/>
                                    <DataGridTextColumn Header="النوع" Binding="{Binding KindText}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="التفصيل" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="12"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="المبلغ" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AmountCentimes, Converter={StaticResource CentimesToDinarsConverter}}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNegative}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C42B1C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2" Text="اختر كشفاً من القائمة لعرض سطوره"
                                       Foreground="Gray" FontSize="13" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding NoRunSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Row="2" Text="لا سطور في هذه المسودة — أعد الحساب أو أضف سطوراً يدوية"
                                       Foreground="Gray" FontSize="13" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding DetailsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- الصرف من كشف معتمد (5.3-هـ) -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                <Button Content="💵 صرف للمستفيد المحدد" Command="{Binding OpenPayoutForLineCommand}"
                                        Padding="14,6" FontWeight="SemiBold"/>
                                <TextBlock Text="الصرف من كشف معتمد فقط · السلفة الحرة من تبويب «الأرصدة»"
                                           Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- سطر يدوي (س-8) — مسودة فقط -->
                            <StackPanel Grid.Row="4" Margin="0,10,0,0" IsEnabled="{Binding IsSelectedDraft}">
                                <TextBlock Text="➕ سطر يدوي (مكافأة / خصم)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding ManualKindOptions}" SelectedItem="{Binding SelectedManualKind}"
                                              DisplayMemberPath="Label" Width="90"/>
                                    <ComboBox ItemsSource="{Binding PayeeOptions}" SelectedItem="{Binding SelectedPayee}"
                                              DisplayMemberPath="Name" MinWidth="180" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBox Text="{Binding ManualAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             Controls:TextBoxHelper.Watermark="المبلغ دج — سالب = خصم" Width="170"/>
                                    <TextBox Text="{Binding ManualReason, UpdateSourceTrigger=PropertyChanged}"
                                             Controls:TextBoxHelper.Watermark="السبب (إلزامي)" Width="200" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="➕ أضف السطر" Command="{Binding AddManualLineCommand}" Padding="12,6"/>
                                    <Button Content="🗑 احذف اليدوي المحدد" Command="{Binding RemoveManualLineCommand}" Padding="12,6" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="5" Text="اليدوية تنجو من إعادة الحساب وتقفل مع الاعتماد · الاعتماد نقطة لاعودة (D-116)"
                                       Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- التبويب الثاني: الأرصدة الجارية (5.3-هـ) -->
            <TabItem Header="💰 الأرصدة">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <Button Content="🔄 تحديث" Command="{Binding RefreshCommand}"
                                DockPanel.Dock="Left" Padding="14,6"/>
                        <TextBlock Text="الأرصدة الجارية — البقية = المعتمد − المصروف عبر التاريخ (الترحيل تلقائي) · السالب بالأحمر = سلفة قائمة"
                                   Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Balances}"
                              SelectedItem="{Binding SelectedBalance}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المستفيد" Binding="{Binding PayeeName}" Width="2*"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding PayeeKindText}" Width="Auto"/>
                            <DataGridTextColumn Header="المعتمد" Binding="{Binding ApprovedCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                            <DataGridTextColumn Header="المصروف" Binding="{Binding PaidCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                            <DataGridTemplateColumn Header="البقية" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BalanceCentimes, Converter={StaticResource CentimesToDinarsConverter}}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNegativeBalance}" Value="True">
                                                            <Setter Property="Foreground" Value="#C42B1C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1" Text="لا أرصدة بعد — اعتمد كشفاً أو سجّل سلفة من الزر أسفله"
                               Foreground="Gray" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding BalancesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="💸 صرف / سلفة للمحدد" Command="{Binding OpenPayoutForBalanceCommand}"
                                Padding="16,8" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>