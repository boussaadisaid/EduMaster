<UserControl x:Class="EduMaster.UI.Payroll.PayrollRunsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls" FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="الأجور" Style="{StaticResource EduPageTitle}"/>
            <TextBlock Text="إعداد كشوف الأجور واعتمادها ومتابعة أرصدة المستفيدين" Style="{StaticResource EduBodyMuted}" Margin="0,4,0,0"/>
        </StackPanel>
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="الكشوف">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="450"/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="بداية الفترة" Style="{StaticResource EduFieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding NewFrom}" Height="38"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="نهاية الفترة" Style="{StaticResource EduFieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding NewTo}" Height="38"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="توليد مسودة" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="8,18,0,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Padding="14,10" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="كشوف الأجور" Style="{StaticResource EduSubsectionTitle}"/>
                                            <TextBlock Text="حدد كشفاً لمراجعة تفاصيله" Style="{StaticResource EduCaption}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Padding="11,6" Margin="0,0,6,0"/>
                                            <Button Content="طباعة" Command="{Binding PrintRunCommand}" Style="{StaticResource SecondaryButton}" Padding="11,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1">
                                    <DataGrid ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="48">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="الفترة" Binding="{Binding PeriodText}" Width="*"/>
                                            <DataGridTemplateColumn Header="الحالة" Width="Auto">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="9" Padding="9,3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#EEF1F5"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDraft}" Value="False">
                                                                            <Setter Property="Background" Value="{StaticResource PositiveSoftBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="مسودة"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDraft}" Value="False">
                                                                                <Setter Property="Text" Value="معتمد"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource PositiveBrush}"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style></TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                                            <DataGridTextColumn Header="السطور" Binding="{Binding LinesCount}" Width="Auto"/>
                                            <DataGridTextColumn Header="الاعتماد" Binding="{Binding ApprovedAtUtc, StringFormat='yyyy-MM-dd', TargetNullValue='—'}" Width="Auto"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="📋" FontSize="28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="لا توجد كشوف بعد" Style="{StaticResource EduBodyStrong}" Margin="0,7,0,0"/>
                                    </StackPanel>
                                    <Border Background="#CCFFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="جارٍ تحميل الكشوف…" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Background="#FAFBFD" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,12,0,0">
                            <WrapPanel>
                                <Button Content="إعادة الحساب" Command="{Binding RegenerateCommand}" Style="{StaticResource SecondaryButton}" Padding="13,7" Margin="0,0,7,0"/>
                                <Button Content="اعتماد نهائي" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}" Padding="13,7" Margin="0,0,7,0"/>
                                <Button Content="حذف المسودة" Command="{Binding DeleteRunCommand}" Style="{StaticResource SecondaryButton}" Padding="13,7"/>
                            </WrapPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Padding="15,11" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                                <TextBlock Text="{Binding SelectedRun.PeriodText, StringFormat='تفاصيل كشف {0}', TargetNullValue='تفاصيل الكشف'}" Style="{StaticResource EduSubsectionTitle}" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Border Grid.Row="1" Background="{StaticResource WarningSoftBrush}" BorderBrush="#E9D7A5" BorderThickness="0,0,0,1" Padding="12,9" Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="حصص لم تدخل الكشف لغياب سياسة مغطية" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding Warnings}" MaxHeight="80">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="2">
                                <DataGrid ItemsSource="{Binding RunLines}" SelectedItem="{Binding SelectedLine}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="المستفيد" Binding="{Binding PayeeName}" Width="*"/>
                                        <DataGridTextColumn Header="النوع" Binding="{Binding KindText}" Width="Auto"/>
                                        <DataGridTemplateColumn Header="التفصيل" Width="1.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="المبلغ" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AmountCentimes, Converter={StaticResource CentimesToDinarsConverter}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNegative}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource NegativeBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style></TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="اختر كشفاً لعرض سطوره" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoRunSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="لا توجد سطور في هذا الكشف" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding DetailsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                            <Border Grid.Row="3" Background="#F7F9FC" BorderBrush="#E8EDF3" BorderThickness="0,1,0,0" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="الصرف متاح من الكشف المعتمد فقط" Style="{StaticResource EduCaption}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="صرف للمستفيد المحدد" Command="{Binding OpenPayoutForLineCommand}" Style="{StaticResource PrimaryButton}" Padding="12,7"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="4" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="12,10" IsEnabled="{Binding IsSelectedDraft}">
                                <StackPanel>
                                    <TextBlock Text="سطر يدوي — مكافأة أو خصم" Style="{StaticResource EduFieldLabel}" Margin="0,0,0,7"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding ManualKindOptions}" SelectedItem="{Binding SelectedManualKind}" DisplayMemberPath="Label" Height="36"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding PayeeOptions}" SelectedItem="{Binding SelectedPayee}" DisplayMemberPath="Name" Height="36" Margin="7,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="145"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ManualAmountText, UpdateSourceTrigger=PropertyChanged}" Controls:TextBoxHelper.Watermark="المبلغ دج" Height="36" Padding="8,5"/>
                                        <TextBox Grid.Column="1" Text="{Binding ManualReason, UpdateSourceTrigger=PropertyChanged}" Controls:TextBoxHelper.Watermark="السبب الإلزامي" Height="36" Padding="8,5" Margin="7,0,0,0"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="إضافة السطر" Command="{Binding AddManualLineCommand}" Style="{StaticResource SecondaryButton}" Padding="11,6" Margin="0,0,6,0"/>
                                        <Button Content="حذف اليدوي المحدد" Command="{Binding RemoveManualLineCommand}" Style="{StaticResource SecondaryButton}" Padding="11,6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="الأرصدة">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="الأرصدة الجارية" Style="{StaticResource EduSectionTitle}"/>
                            <TextBlock Text="البقية = المعتمد − المصروف عبر التاريخ، والسالب يعني سلفة قائمة" Style="{StaticResource EduBodyMuted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Padding="13,7" Margin="0,0,7,0"/>
                            <Button Content="طباعة الأرصدة" Command="{Binding PrintBalancesCommand}" Style="{StaticResource PrimaryButton}" Padding="15,7"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <DataGrid ItemsSource="{Binding Balances}" SelectedItem="{Binding SelectedBalance}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="48">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="المستفيد" Binding="{Binding PayeeName}" Width="2*"/>
                                    <DataGridTextColumn Header="النوع" Binding="{Binding PayeeKindText}" Width="Auto"/>
                                    <DataGridTextColumn Header="المعتمد" Binding="{Binding ApprovedCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                                    <DataGridTextColumn Header="المصروف" Binding="{Binding PaidCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="البقية" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="9" Padding="10,3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource PositiveSoftBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNegativeBalance}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource NegativeSoftBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding BalanceCentimes, Converter={StaticResource CentimesToDinarsConverter}}" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource PositiveBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNegativeBalance}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource NegativeBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style></TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding BalancesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="💰" FontSize="28" HorizontalAlignment="Center"/>
                                <TextBlock Text="لا توجد أرصدة بعد" Style="{StaticResource EduBodyStrong}" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Background="#FAFBFD" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="يمكن تسجيل صرف أو سلفة للمستفيد المحدد" Style="{StaticResource EduCaption}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="صرف / سلفة للمحدد" Command="{Binding OpenPayoutForBalanceCommand}" Style="{StaticResource PrimaryButton}" Padding="17,8"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>