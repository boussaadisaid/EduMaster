<UserControl x:Class="EduMaster.UI.Sms.SmsTemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Width="760" Height="560">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="22,20,22,14">
            <TextBlock Text="قوالب SMS" Style="{StaticResource EduSectionTitle}"/>
            <TextBlock Text="أنشئ قوالب جاهزة قابلة للتعديل وإعادة الاستخدام" Style="{StaticResource EduBodyMuted}" Margin="0,3,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="22,0,22,12" Padding="0">
            <DataGrid ItemsSource="{Binding Templates}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="42">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم القالب" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding CategoryText}" Width="150"/>
                    <DataGridTextColumn Header="النص" Binding="{Binding Body}" Width="2*"/>
                    <DataGridTemplateColumn Header="الحالة" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToArabicTextConverter}}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal">
                <Button Content="قالب جديد" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8"/>
                <Button Content="تعديل" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="8,0,0,0"/>
                <Button Content="تفعيل / تعطيل" Command="{Binding ToggleCommand}" Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="8,0,0,0"/>
                <Button Content="إغلاق" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
