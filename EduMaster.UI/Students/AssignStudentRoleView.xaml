<UserControl x:Class="EduMaster.UI.Students.AssignStudentRoleView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             FlowDirection="RightToLeft" Width="650" Height="620">

    <UserControl.Resources>
        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="InputCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>
        <Style x:Key="ActionPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="20,8"/>
        </Style>
        <Style x:Key="ActionSecondary" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="20,8"/>
        </Style>
        <Style x:Key="ModernGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F6"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,20,22,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,0,2,18">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#EAF3FC" Margin="0,0,12,0">
                        <TextBlock Text="🎓" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إسناد دور الطالب" Style="{StaticResource EduSectionTitle}"/>
                        <TextBlock Text="إضافة ملف طالب فوق الشخص المحدد دون تكرار هويته" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="الشخص المحدد" Style="{StaticResource EduFieldLabel}"/>
                        <Border Background="#EEF5FC" CornerRadius="8" Padding="12,9" Margin="0,0,0,16">
                            <TextBlock Text="{Binding PersonName}" Style="{StaticResource EduBodyStrong}" Foreground="{StaticResource AccentDarkBrush}"/>
                        </Border>
                        <TextBlock Text="صنف الطالب *" Style="{StaticResource EduFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource InputCombo}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="ولي الأمر" Style="{StaticResource EduSubsectionTitle}"/>
                        <TextBlock Text="اختياري — اختر شخصاً مسجلاً مسبقاً" Style="{StaticResource EduCaption}" Margin="0,3,0,12"/>
                        <Border Background="{StaticResource PositiveSoftBrush}" BorderBrush="#B7DFB7" BorderThickness="1" CornerRadius="8" Padding="12,9" Visibility="{Binding HasGuardian, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel>
                                <Button Content="إزالة" Command="{Binding ClearGuardianCommand}" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Padding="12,5"/>
                                <TextBlock Text="{Binding GuardianName}" Style="{StaticResource EduBodyStrong}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <StackPanel Visibility="{Binding HasNoGuardian, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Background="#F6F8FB" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="8" Padding="4,1">
                                <TextBox Text="{Binding GuardianSearchText, UpdateSourceTrigger=PropertyChanged}" Controls:TextBoxHelper.Watermark="ابحث بالاسم أو الهاتف…" Background="Transparent" BorderThickness="0" Padding="10,7"/>
                            </Border>
                            <ListBox ItemsSource="{Binding GuardianResults}" SelectedItem="{Binding PickedGuardian}" DisplayMemberPath="FullName" MaxHeight="120" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="ملاحظات" Style="{StaticResource EduFieldLabel}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="68" Padding="10,8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="إسناد الدور" Command="{Binding SaveCommand}" Style="{StaticResource ActionPrimary}" Margin="0,0,8,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource ActionSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>