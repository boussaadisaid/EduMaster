<UserControl x:Class="EduMaster.UI.Students.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             FlowDirection="RightToLeft">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- العمود الأيمن: قائمة الطلاب (كما هي) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,14">
                <Button Content="➕ طالب جديد" Command="{Binding AddCommand}"
                        DockPanel.Dock="Left" Padding="18,8" FontWeight="SemiBold"/>
                <TextBlock Text="الطلاب" FontSize="24" FontWeight="SemiBold"/>
            </DockPanel>

            <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Controls:TextBoxHelper.Watermark="🔍 ابحث بالاسم أو الهاتف أو اسم ولي الأمر…"
                     Padding="10,8" Margin="0,0,0,14"/>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Students}"
                      SelectedItem="{Binding SelectedStudent}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="2*"/>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding CategoryText}" Width="*"/>
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="*"/>
                    <DataGridTextColumn Header="ولي الأمر" Binding="{Binding GuardianFullName, TargetNullValue='—'}" Width="*"/>
                    <DataGridTemplateColumn Header="الحالة" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="فعّال"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Text" Value="معطّل"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="لا يوجد طلاب بعد — اضغط «طالب جديد» لإضافة أول طالب"
                       Foreground="Gray" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Grid.Row="2" Text="جارٍ التحميل…" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="✏️ تعديل"        Command="{Binding EditCommand}"       Padding="14,6" Margin="0,0,8,0"/>
                <Button Content="🚫 تعطيل"       Command="{Binding DeactivateCommand}" Padding="14,6" Margin="0,0,8,0"/>
                <Button Content="✔ تفعيل"        Command="{Binding ActivateCommand}"   Padding="14,6" Margin="0,0,8,0"/>
                <Button Content="🗑 إزالة الملف"  Command="{Binding RemoveFileCommand}" Padding="14,6"/>
            </StackPanel>
        </Grid>

        <!-- العمود الأيسر: لوحة الطالب — تسجيلاته السنوية (2.3) + أفواجه بالعمليات والرصيد (2.4/3.2) -->
        <Border Grid.Column="1" Margin="16,0,0,0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding SelectedStudent.FullName, StringFormat='تسجيلات: {0}', TargetNullValue='التسجيلات السنوية'}"
                           FontWeight="SemiBold" FontSize="15"/>

                <DataGrid Grid.Row="1" Margin="0,8,0,0"
                          ItemsSource="{Binding Enrollments}"
                          SelectedItem="{Binding SelectedEnrollment}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="السنة" Binding="{Binding AcademicYearName}" Width="*"/>
                        <DataGridTextColumn Header="المستوى" Binding="{Binding LevelName}" Width="*"/>
                        <DataGridTextColumn Header="الشعبة" Binding="{Binding StreamDisplay}" Width="*"/>
                        <DataGridTextColumn Header="الحقوق" Binding="{Binding AgreedRegistrationFeeCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="*"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Text="اختر طالباً من القائمة لعرض تسجيلاته وأفواجه"
                           Foreground="Gray" FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding NoStudentSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="1" Text="لا تسجيلات بعد — اضغط «تسجيل سنوي» لأول تسجيل"
                           Foreground="Gray" FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding EnrollmentsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="➕ تسجيل سنوي" Command="{Binding AddEnrollmentCommand}"      Padding="12,6" Margin="0,0,6,0"/>
                    <Button Content="✏️ تعديل"      Command="{Binding EditEnrollmentCommand}"     Padding="12,6" Margin="0,0,6,0"/>
                    <Button Content="↩ انسحاب"     Command="{Binding WithdrawEnrollmentCommand}" Padding="12,6"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="أفواجه" FontWeight="SemiBold" FontSize="15" Margin="0,14,0,0"/>

                <DataGrid Grid.Row="4" Margin="0,8,0,0"
                          ItemsSource="{Binding StudentGroups}"
                          SelectedItem="{Binding SelectedGroupEnrollment}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الفوج" Binding="{Binding ClassGroupName}" Width="2*"/>
                        <DataGridTextColumn Header="السعر" Binding="{Binding AgreedUnitPriceCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                        <DataGridTemplateColumn Header="الرصيد" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- D-92/D-98: المتبقي — أحمر غامق عند السالب -->
                                    <TextBlock Text="{Binding Balance}" FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNegativeBalance}" Value="True">
                                                        <Setter Property="Foreground" Value="#C42B1C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="4" Text="لا أفواج بعد — اضغط «إلحاق بفوج» لأول إلحاق"
                           Foreground="Gray" FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding StudentGroupsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="➕ إلحاق بفوج"  Command="{Binding EnrollInGroupCommand}"            Padding="12,6" Margin="0,0,6,0"/>
                    <Button Content="🎟 شراء حصص"    Command="{Binding PurchaseSessionsCommand}"         Padding="12,6" Margin="0,0,6,0"/>
                    <Button Content="↩ انسحاب"      Command="{Binding WithdrawGroupEnrollmentCommand}" Padding="12,6" Margin="0,0,6,0"/>
                    <Button Content="🔀 نقل"         Command="{Binding TransferGroupEnrollmentCommand}" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>