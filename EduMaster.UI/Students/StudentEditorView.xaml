<UserControl x:Class="EduMaster.UI.Students.StudentEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls" FlowDirection="RightToLeft" Width="720" Height="640">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="22,18,22,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" CornerRadius="24" Background="#EAF3FC" Margin="0,0,12,0">
                    <TextBlock Text="👤" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource EduSectionTitle}"/>
                    <TextBlock Text="بيانات الطالب وولي الأمر والصورة" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Width="76" Height="76" CornerRadius="38" Background="#EEF5FC" BorderBrush="#D5E5F4" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="📷" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoPhotoPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Image Source="{Binding PhotoPreview}" Stretch="UniformToFill" Visibility="{Binding HasPhotoPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="اختيار صورة…" Click="PickPhoto_Click" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,0,6"/>
                    <Button Content="إزالة" Command="{Binding RemovePhotoCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,12">
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock Text="البيانات الشخصية" Style="{StaticResource EduSubsectionTitle}" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,14">
                            <TextBlock Text="الاسم الأول *" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,14">
                            <TextBlock Text="اللقب *" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,14">
                            <TextBlock Text="اسم الأب" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding FatherName, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,14">
                            <TextBlock Text="تاريخ الميلاد" Style="{StaticResource EduFieldLabel}"/>
                            <DatePicker SelectedDate="{Binding BirthDate}" Height="40"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,14">
                            <TextBlock Text="الجنس" Style="{StaticResource EduFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding GenderOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedGender}" Height="40" Padding="8,5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,14">
                            <TextBlock Text="صنف الطالب *" Style="{StaticResource EduFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedCategory}" Height="40" Padding="8,5"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,14">
                            <TextBlock Text="الهاتف" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,14">
                            <TextBlock Text="هاتف ثانٍ" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding Phone2, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,14">
                            <TextBlock Text="البريد الإلكتروني" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,14">
                            <TextBlock Text="العنوان" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        </StackPanel>
                    </Grid>
                    <Border Background="#F7F9FC" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="9" Padding="14,11" Margin="0,2,0,14">
                        <StackPanel>
                            <TextBlock Text="ولي الأمر (اختياري)" Style="{StaticResource EduFieldLabel}"/>
                            <Border Background="{StaticResource PositiveSoftBrush}" CornerRadius="8" Padding="12,8" Margin="0,6,0,0" Visibility="{Binding HasGuardian, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding GuardianName}" Style="{StaticResource EduBodyStrong}" Foreground="{StaticResource PositiveBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="إزالة" Command="{Binding ClearGuardianCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4"/>
                                </Grid>
                            </Border>
                            <StackPanel Margin="0,6,0,0" Visibility="{Binding HasNoGuardian, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox Text="{Binding GuardianSearchText, UpdateSourceTrigger=PropertyChanged}" Controls:TextBoxHelper.Watermark="ابحث بالاسم أو الهاتف…" Height="40" Padding="10,6"/>
                                <ListBox ItemsSource="{Binding GuardianResults}" SelectedItem="{Binding PickedGuardian}" DisplayMemberPath="FullName" MaxHeight="120" Margin="0,5,0,0" BorderBrush="#E3E8F0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="0" Margin="0">
                        <TextBlock Text="ملاحظات" Style="{StaticResource EduFieldLabel}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="68" AcceptsReturn="True" TextWrapping="Wrap" Padding="10,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="حفظ" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="20,9" Margin="0,0,8,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Padding="20,9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>