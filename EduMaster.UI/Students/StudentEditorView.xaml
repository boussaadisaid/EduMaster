<UserControl x:Class="EduMaster.UI.Students.StudentEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- الحقول: تُمرَّر -->
            <RowDefinition Height="Auto"/>
            <!-- التذييل: مثبّت دائماً -->
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel MinWidth="560">

                <!-- الصورة -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="84" Height="84" CornerRadius="42" BorderBrush="#C7D4F5" BorderThickness="1"
                            Background="#F0F4FF" Margin="0,0,14,0">
                        <Grid>
                            <TextBlock Text="📷" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoPhotoPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Image Source="{Binding PhotoPreview}" Stretch="UniformToFill"
                                   Visibility="{Binding HasPhotoPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <Button Content="اختر صورة…" Click="PickPhoto_Click" Padding="14,6" Margin="0,0,0,6"/>
                        <Button Content="إزالة" Command="{Binding RemovePhotoCommand}" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>

                <!-- صف: الاسم الأول | اللقب -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="الاسم الأول *" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="اللقب *" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- صف: اسم الأب | تاريخ الميلاد -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="اسم الأب" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FatherName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="تاريخ الميلاد" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding BirthDate}"/>
                    </StackPanel>
                </Grid>

                <!-- صف: الجنس | صنف الطالب -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="الجنس" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding GenderOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedGender}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="صنف الطالب *" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedCategory}"/>
                    </StackPanel>
                </Grid>

                <!-- صف: الهاتف | هاتف ثانٍ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="الهاتف" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="هاتف ثانٍ" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Phone2, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- صف: البريد | العنوان -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="البريد الإلكتروني" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="العنوان" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- ولي الأمر -->
                <TextBlock Text="ولي الأمر (اختياري)" FontWeight="SemiBold" Margin="0,0,0,4"/>

                <Border Background="#EAF6EA" BorderBrush="#B7DFB7" BorderThickness="1" CornerRadius="4"
                        Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding HasGuardian, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <Button Content="✕ إزالة" Command="{Binding ClearGuardianCommand}" DockPanel.Dock="Left" Padding="10,4"/>
                        <TextBlock Text="{Binding GuardianName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </DockPanel>
                </Border>

                <StackPanel Margin="0,0,0,10"
                            Visibility="{Binding HasNoGuardian, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBox Text="{Binding GuardianSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Controls:TextBoxHelper.Watermark="🔍 ابحث عن ولي الأمر بالاسم أو الهاتف…"
                             Padding="8,6"/>
                    <ListBox ItemsSource="{Binding GuardianResults}" SelectedItem="{Binding PickedGuardian}"
                             DisplayMemberPath="FullName" MaxHeight="130" Margin="0,4,0,0"
                             BorderThickness="1" BorderBrush="#DDD"/>
                </StackPanel>

                <TextBlock Text="ملاحظات" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="56"/>
            </StackPanel>
        </ScrollViewer>

        <!-- التذييل المثبّت: البانر + الأزرار -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="💾 حفظ" Command="{Binding SaveCommand}" Padding="22,8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>