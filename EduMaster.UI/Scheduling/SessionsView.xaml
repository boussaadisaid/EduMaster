<UserControl x:Class="EduMaster.UI.Scheduling.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <Button Content="🔄 تحديث" Command="{Binding RefreshCommand}"
                    DockPanel.Dock="Left" Padding="14,8"/>
            <TextBlock Text="الحصص" FontSize="24" FontWeight="SemiBold"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="130"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="إلى" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="130"/>
            </StackPanel>
            <ComboBox Grid.Column="2" ItemsSource="{Binding GroupFilters}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedGroupFilter}" Padding="10,6" Margin="12,0,0,0"
                      MaxWidth="320" HorizontalAlignment="Left" MinWidth="240"/>
        </Grid>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Sessions}"
                  SelectedItem="{Binding SelectedSession}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding TimeDisplay}" Width="Auto"/>
                <DataGridTextColumn Header="الفوج" Binding="{Binding GroupName}" Width="2*"/>
                <DataGridTextColumn Header="المادة" Binding="{Binding SubjectName}" Width="*"/>
                <DataGridTextColumn Header="الأستاذ" Binding="{Binding TeacherFullName, TargetNullValue='—'}" Width="*"/>
                <DataGridTextColumn Header="القاعة" Binding="{Binding RoomName, TargetNullValue='—'}" Width="Auto"/>
                <DataGridTextColumn Header="المدة" Binding="{Binding DurationMinutes, StringFormat='.{0} د'}" Width="Auto"/>
                <DataGridTextColumn Header="المتوقعون" Binding="{Binding ActiveEnrolledCount}" Width="Auto"/>
                <DataGridTextColumn Header="المصدر" Binding="{Binding SourceText}" Width="Auto"/>
                <DataGridTextColumn Header="الموضوع" Binding="{Binding Topic, TargetNullValue='—'}" Width="*"/>
                <DataGridTemplateColumn Header="الحالة" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value="مُقامة">
                                                <Setter Property="Foreground" Value="#107C10"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="ملغاة">
                                                <Setter Property="Foreground" Value="Gray"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="لا حصص في هذه الفترة — ولّدها من جدول استعمال الزمن أو أضف استثنائية"
                   Foreground="Gray" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <TextBlock Grid.Row="2" Text="جارٍ التحميل…" Foreground="Gray"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="✔ أُقيمت"      Command="{Binding MarkHeldCommand}"      Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="📋 الحضور"     Command="{Binding AttendanceCommand}"    Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="✕ إلغاء الحصة" Command="{Binding CancelSessionCommand}" Padding="14,6"/>
            <Button Content="🔧 لقطة الأستاذ" Command="{Binding CorrectTeacherCommand}" Padding="14,6" Margin="8,0,0,0"
                    ToolTip="تعيين من أقام هذه الحصة فعلاً — للمُقامة بلقطة فارغة فقط (تصحيح أجور — 6.6)"/>
        </StackPanel>
    </Grid>
</UserControl>