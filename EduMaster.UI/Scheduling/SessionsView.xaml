<UserControl x:Class="EduMaster.UI.Scheduling.SessionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <UserControl.Resources>
        <Style x:Key="SessionsGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F6"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="58"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="ToolbarPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="{StaticResource NegativeBrush}"/>
            <Setter Property="BorderBrush" Value="#F2C9C5"/>
            <Setter Property="Background" Value="#FFF8F7"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="الحصص" Style="{StaticResource EduPageTitle}"/>
                <TextBlock Text="متابعة الحصص المجدولة والمقامة والحضور ولقطة الأستاذ" Style="{StaticResource EduBodyMuted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="↻  تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButton}" Margin="0"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,7,0">
                    <TextBlock Text="من تاريخ" Style="{StaticResource EduFieldLabel}"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Height="40"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="7,0">
                    <TextBlock Text="إلى تاريخ" Style="{StaticResource EduFieldLabel}"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Height="40"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="7,0,0,0">
                    <TextBlock Text="الفوج" Style="{StaticResource EduFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding GroupFilters}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedGroupFilter}" Height="40" Padding="10,6"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Padding="18,13" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                    <StackPanel>
                        <TextBlock Text="قائمة الحصص" Style="{StaticResource EduSubsectionTitle}"/>
                        <TextBlock Text="حدد حصة لتسجيل إقامتها أو حضورها أو إلغائها" Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Style="{StaticResource SessionsGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding TimeDisplay}" Width="Auto"/>
                            <DataGridTemplateColumn Header="الفوج والمادة" Width="1.7*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GroupName}" Style="{StaticResource EduBodyStrong}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SubjectName}" Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="التأطير" Width="1.35*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TeacherFullName, TargetNullValue='بلا أستاذ'}" Style="{StaticResource EduBodyStrong}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding RoomName, StringFormat='القاعة: {0}', TargetNullValue='بلا قاعة'}" Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="التفاصيل" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Topic, TargetNullValue='بلا موضوع'}" Style="{StaticResource EduBodyStrong}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource EduCaption}" Margin="0,2,0,0">
                                                <Run Text="{Binding DurationMinutes, Mode=OneWay}"/><Run Text=" د · "/><Run Text="{Binding ActiveEnrolledCount, Mode=OneWay}"/><Run Text=" متوقع · "/><Run Text="{Binding SourceText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="الحالة" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#BFDBFE"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="مُقامة">
                                                            <Setter Property="Background" Value="#BBF0C4"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="ملغاة">
                                                            <Setter Property="Background" Value="#E2E4E9"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="مُقامة">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="ملغاة">
                                                                <Setter Property="Foreground" Value="#374151"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Width="58" Height="58" CornerRadius="29" Background="#EAF3FC" Margin="0,0,0,11">
                            <TextBlock Text="✅" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="لا حصص في هذه الفترة" Style="{StaticResource EduBodyStrong}" HorizontalAlignment="Center"/>
                        <TextBlock Text="ولّد الحصص من الجدول أو أضف حصة استثنائية" Style="{StaticResource EduBodyMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Background="#CCFFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="125" Height="4"/>
                            <TextBlock Text="جارٍ تحميل الحصص…" Style="{StaticResource EduBodyMuted}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="2" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,1,0,0" Padding="14,11" CornerRadius="0,0,10,10">
                    <WrapPanel>
                        <Button Content="تسجيل الإقامة" Command="{Binding MarkHeldCommand}" Style="{StaticResource ToolbarPrimary}" Margin="0,0,8,0"/>
                        <Button Content="📋  الحضور" Command="{Binding AttendanceCommand}" Style="{StaticResource ToolbarButton}"/>
                        <Button Content="تصحيح لقطة الأستاذ" Command="{Binding CorrectTeacherCommand}" Style="{StaticResource ToolbarButton}" ToolTip="للحصة المقامة بلقطة أستاذ فارغة فقط"/>
                        <Button Content="إلغاء الحصة" Command="{Binding CancelSessionCommand}" Style="{StaticResource DangerButton}" Margin="0"/>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>