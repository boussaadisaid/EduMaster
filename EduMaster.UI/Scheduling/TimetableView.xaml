<UserControl x:Class="EduMaster.UI.Scheduling.TimetableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="➕ موعد جديد" Command="{Binding AddSlotCommand}" Padding="14,8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="⚡ ولّد الحصص" Command="{Binding GenerateCommand}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="＋ حصة استثنائية" Command="{Binding AdHocCommand}" Padding="14,8"/>
            </StackPanel>
            <CheckBox Content="عرض المعطّلة" IsChecked="{Binding ShowInactive}" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,12,0"/>
            <TextBlock Text="جدول استعمال الزمن" FontSize="24" FontWeight="SemiBold"/>
        </DockPanel>

        <!-- شبكة الأيام السبعة (RTL: السبت يميناً أولاً) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,0,4,8" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="6">
                                <StackPanel>
                                    <TextBlock Text="{Binding DayName}" FontWeight="Bold" FontSize="15"
                                               HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                    <ListBox ItemsSource="{Binding Slots}"
                                             SelectedItem="{Binding DataContext.SelectedSlot, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,6"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F0F4FF" BorderBrush="#C7D4F5" BorderThickness="1"
                                                        CornerRadius="6" Padding="8,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding SubjectName}" Foreground="#445566" FontSize="12"/>
                                                        <TextBlock Text="{Binding TimeDisplay}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding TeacherFullName, TargetNullValue='—'}" Foreground="Gray" FontSize="12"/>
                                                        <TextBlock Text="{Binding RoomName, StringFormat='قاعة: {0}', TargetNullValue='بلا قاعة'}" Foreground="Gray" FontSize="11"/>
                                                    </StackPanel>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="الجدول فارغ — اضغط «موعد جديد» لأول موعد أسبوعي"
                           Foreground="Gray" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="✏️ تعديل الموعد"  Command="{Binding EditSlotCommand}"       Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="🚫 تعطيل الموعد" Command="{Binding DeactivateSlotCommand}" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="✔ تفعيل الموعد"  Command="{Binding ActivateSlotCommand}"   Padding="14,6"/>
        </StackPanel>
    </Grid>
</UserControl>