<UserControl x:Class="EduMaster.UI.Scheduling.TimetableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <!-- أنماط محلية: تحديث شاشة الجدول فقط مع الحفاظ على خط Cairo العام -->
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="ToolbarPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="{StaticResource NegativeBrush}"/>
            <Setter Property="BorderBrush" Value="#F2C9C5"/>
            <Setter Property="Background" Value="#FFF8F7"/>
        </Style>

        <Style x:Key="SlotItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- رأس الشاشة -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="جدول استعمال الزمن" Style="{StaticResource EduPageTitle}"/>
                <TextBlock Text="المواعيد الأسبوعية الثابتة التي تُبنى منها حصص الأفواج"
                           Style="{StaticResource EduBodyMuted}" Margin="0,4,0,0"/>
            </StackPanel>

            <WrapPanel Grid.Column="1">
                <Button Content="＋  موعد جديد" Command="{Binding AddSlotCommand}"
                        Style="{StaticResource ToolbarPrimaryButton}" Margin="0,0,8,0"/>
                <Button Content="⚡  توليد الحصص" Command="{Binding GenerateCommand}"
                        Style="{StaticResource ToolbarButton}"/>
                <Button Content="＋  حصة استثنائية" Command="{Binding AdHocCommand}"
                        Style="{StaticResource ToolbarButton}" Margin="0"/>
            </WrapPanel>
        </Grid>

        <!-- شريط الحالة والتحكم -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17" Background="#EAF3FC" Margin="0,0,10,0">
                        <TextBlock Text="🗓" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="الأسبوع التشغيلي" Style="{StaticResource EduBodyStrong}"/>
                        <TextBlock Text="من السبت إلى الجمعة — اختر بطاقة موعد لإدارته"
                                   Style="{StaticResource EduCaption}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <CheckBox Grid.Column="1" Content="عرض المواعيد المعطّلة"
                          IsChecked="{Binding ShowInactive}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- شبكة الأيام السبعة -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Days}" MinWidth="980">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4" BorderBrush="#E3E8F0" BorderThickness="1"
                                        CornerRadius="9" Background="#FBFCFE" MinHeight="440">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Background="#F2F6FB" BorderBrush="#E3E8F0"
                                                BorderThickness="0,0,0,1" CornerRadius="9,9,0,0"
                                                Padding="10,9">
                                            <TextBlock Text="{Binding DayName}" Style="{StaticResource EduSubsectionTitle}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <ListBox Grid.Row="1" ItemsSource="{Binding Slots}"
                                                 SelectedItem="{Binding DataContext.SelectedSlot, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0" Padding="7"
                                                 ItemContainerStyle="{StaticResource SlotItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="8" Padding="9,8">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="BorderBrush" Value="#DDE6F0"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Background" Value="#EAF3FC"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                        <Setter Property="Background" Value="#F1F2F4"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding TimeDisplay}" Style="{StaticResource EduBodyStrong}"
                                                                       Foreground="{StaticResource AccentDarkBrush}"/>
                                                            <TextBlock Text="{Binding GroupName}" Style="{StaticResource EduBodyStrong}"
                                                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                            <TextBlock Text="{Binding SubjectName}" Style="{StaticResource EduCaption}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                            <Border Height="1" Background="#EDF1F6" Margin="0,7"/>
                                                            <TextBlock Text="{Binding TeacherFullName, TargetNullValue='بلا أستاذ'}"
                                                                       Style="{StaticResource EduCaption}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding RoomName, StringFormat='القاعة: {0}', TargetNullValue='بلا قاعة'}"
                                                                       Style="{StaticResource EduCaption}" TextTrimming="CharacterEllipsis"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="62" Height="62" CornerRadius="31" Background="#EAF3FC" Margin="0,0,0,12">
                        <TextBlock Text="🗓" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="جدول الأسبوع فارغ" Style="{StaticResource EduSectionTitle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="أضف أول موعد أسبوعي لبدء بناء الجدول"
                               Style="{StaticResource EduBodyMuted}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border Background="#CCFFFFFF"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="130" Height="4"/>
                        <TextBlock Text="جارٍ تحميل الجدول…" Style="{StaticResource EduBodyMuted}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- إجراءات الموعد المحدد -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,11" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="الموعد المحدد" Style="{StaticResource EduBodyStrong}"/>
                    <TextBlock Text="اختر بطاقة من الجدول لتعديلها أو تغيير حالتها"
                               Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Column="1">
                    <Button Content="✎  تعديل الموعد" Command="{Binding EditSlotCommand}"
                            Style="{StaticResource ToolbarButton}"/>
                    <Button Content="تعطيل الموعد" Command="{Binding DeactivateSlotCommand}"
                            Style="{StaticResource DangerButton}"/>
                    <Button Content="تفعيل الموعد" Command="{Binding ActivateSlotCommand}"
                            Style="{StaticResource ToolbarButton}" Margin="0"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
