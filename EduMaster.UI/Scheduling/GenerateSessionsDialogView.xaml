<UserControl x:Class="EduMaster.UI.Scheduling.GenerateSessionsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="380">
            <StackPanel MinWidth="420">
                <TextBlock Text="تُولَّد الحصص المجدولة من المواعيد الفعّالة — وما هو مولَّد مسبقاً يُتجاوَز بأمان (لا تكرار أبداً)."
                           Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="النطاق" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding GroupFilters}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedGroupFilter}" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="من تاريخ *" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FromDate}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="إلى تاريخ *" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding ToDate}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="⚡ توليد" Command="{Binding SaveCommand}" Padding="22,8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>