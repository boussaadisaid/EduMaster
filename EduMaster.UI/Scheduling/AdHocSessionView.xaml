<UserControl x:Class="EduMaster.UI.Scheduling.AdHocSessionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="600" Height="510">
    <UserControl.Resources>
        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="InputCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="InputDate" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
            <Setter Property="Height" Value="38"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>
        <Style x:Key="ActionPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="20,8"/>
        </Style>
        <Style x:Key="ActionSecondary" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="20,8"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,20,22,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,0,2,18">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#EAF3FC" Margin="0,0,12,0">
                        <TextBlock Text="＋" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentDarkBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="حصة استثنائية" Style="{StaticResource EduSectionTitle}"/>
                        <TextBlock Text="حصة غير دورية لا تعتمد على موعد في الجدول" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="الفوج *" Style="{StaticResource EduFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Groups}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedGroup}" Style="{StaticResource InputCombo}" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,14">
                                <TextBlock Text="التاريخ *" Style="{StaticResource EduFieldLabel}"/>
                                <DatePicker SelectedDate="{Binding Date}" Style="{StaticResource InputDate}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,14">
                                <TextBlock Text="الساعة بنظام 24 ساعة *" Style="{StaticResource EduFieldLabel}"/>
                                <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="المدة بالدقائق *" Style="{StaticResource EduFieldLabel}"/>
                        <TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>
                        <TextBlock Text="الموضوع الاختياري" Style="{StaticResource EduFieldLabel}"/>
                        <TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                </Border>
                <Border Background="#EEF5FC" BorderBrush="#D5E5F4" BorderThickness="1" CornerRadius="8" Padding="12,9">
                    <TextBlock Text="يمكن تسجيل الحصة بتاريخ سابق لتوثيق حصة فاتت جدولتها." Style="{StaticResource EduCaption}" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="حفظ الحصة" Command="{Binding SaveCommand}" Style="{StaticResource ActionPrimary}" Margin="0,0,8,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource ActionSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>