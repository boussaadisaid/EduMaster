<UserControl x:Class="EduMaster.UI.Scheduling.CorrectSessionTeacherDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" MinWidth="440">
            <TextBlock Text="للحصة المُقامة بلا أستاذ مسند لحظتها (لقطة فارغة) — عيّن من أقامها فعلاً لتدخل حصتها الأجور. اللقطات القائمة لا تُعاد كتابتها أبداً."
                       Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Text="الحصة" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding SessionText}" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <TextBlock Text="من أقامها فعلاً؟ *" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Teachers}" DisplayMemberPath="FullName"
                      SelectedItem="{Binding SelectedTeacher}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="💾 حفظ التصحيح" Command="{Binding SaveCommand}" Padding="22,8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
