<UserControl x:Class="EduMaster.UI.Scheduling.PurchaseSessionsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="340">
            <StackPanel MinWidth="400">
                <TextBlock Text="{Binding ContextText}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="عدد الحصص *" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SessionsCountText, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Right"/>
                <TextBlock Text="عرف الشهر = 4 حصص · الثمن يُحسب من سعر الحصة المتفق عليه في التسجيل (D-96)"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>

                <TextBlock Text="ملاحظة (اختياري)" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="🎟 شراء" Command="{Binding SaveCommand}" Padding="22,8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>