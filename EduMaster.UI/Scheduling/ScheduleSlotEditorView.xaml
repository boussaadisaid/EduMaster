<UserControl x:Class="EduMaster.UI.Scheduling.ScheduleSlotEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- الحقول -->
            <RowDefinition Height="Auto"/>
            <!-- التذييل المثبّت (D-41) -->
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="420">
            <StackPanel MinWidth="440">

                <!-- الفوج: منتقٍ في الإنشاء، ثابت في التحرير -->
                <StackPanel Visibility="{Binding IsCreateMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="الفوج *" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Groups}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedGroup}" Margin="0,0,0,12"/>
                </StackPanel>
                <StackPanel Visibility="{Binding HasCascadeNote, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="الفوج" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding GroupFixedText}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="يوم الأسبوع *" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Days}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedDay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="الساعة * (24س)" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="المدة بالدقائق *" Margin="0,0,0,4"/>
                <TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Text="يُفحص تعارض القاعة/الأستاذ تلقائياً قبل الحفظ — تحذير غير مانع (D-89)"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Text="تعديل الموعد يلغي حصصه المستقبلية المجدولة تلقائياً (D-88)"
                           Foreground="#B26A00" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding HasCascadeNote, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="💾 حفظ" Command="{Binding SaveCommand}" Padding="22,8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>