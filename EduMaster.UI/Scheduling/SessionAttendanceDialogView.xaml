<UserControl x:Class="EduMaster.UI.Scheduling.SessionAttendanceDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="800" Height="650">

    <UserControl.Resources>
        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="InputCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="InputDate" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
            <Setter Property="Height" Value="38"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>
        <Style x:Key="ActionPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="20,8"/>
        </Style>
        <Style x:Key="ActionSecondary" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="20,8"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="22,20,22,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" CornerRadius="24" Background="#EAF3FC" Margin="0,0,12,0">
                    <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="حضور الحصة" Style="{StaticResource EduSectionTitle}"/>
                    <TextBlock Text="{Binding ContextText}" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="✓  الكل حاضر" Command="{Binding MarkAllPresentCommand}" Style="{StaticResource ActionSecondary}"/>
        </Grid>
        <Border Grid.Row="1" Margin="22,0,22,10" Style="{StaticResource SectionCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Padding="16,12" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                    <TextBlock Text="{Binding CountsText}" Style="{StaticResource EduBodyStrong}"/>
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" VerticalGridLinesBrush="Transparent" BorderThickness="0" RowHeight="52" ColumnHeaderHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الطالب" Binding="{Binding FullName}" Width="2*" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="الحالة" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="حاضر" Command="{Binding SetPresentCommand}" Padding="10,4" Margin="0,0,5,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionSecondary}">
                                                    <Setter Property="MinHeight" Value="32"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                                            <Setter Property="Background" Value="#BBF0C4"/>
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                            <Setter Property="BorderBrush" Value="#7FCF8F"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="غائب" Command="{Binding SetAbsentCommand}" Padding="10,4" Margin="0,0,5,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionSecondary}">
                                                    <Setter Property="MinHeight" Value="32"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAbsent}" Value="True">
                                                            <Setter Property="Background" Value="#F5A3A3"/>
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                            <Setter Property="BorderBrush" Value="#E27878"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="مبرر" Command="{Binding SetJustifiedCommand}" Padding="10,4">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionSecondary}">
                                                    <Setter Property="MinHeight" Value="32"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsJustified}" Value="True">
                                                            <Setter Property="Background" Value="#FCD780"/>
                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                            <Setter Property="BorderBrush" Value="#E8B84B"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="ملاحظة" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0,0,0,1" Padding="6,3"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="2" Background="#F8FAFD" Padding="14,10" BorderBrush="#E8EDF3" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10">
                    <TextBlock Text="الحاضر والغائب يخصمان من الرصيد، أما الغياب المبرر فلا يخصم. يمكن التصحيح لاحقاً بإعادة فتح الحصة." Style="{StaticResource EduCaption}" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="حفظ الحضور" Command="{Binding SaveCommand}" Style="{StaticResource ActionPrimary}" Margin="0,0,8,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource ActionSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>