<UserControl x:Class="EduMaster.UI.ClassGroups.ClassGroupRosterDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls" FlowDirection="RightToLeft" Width="820" MaxHeight="680">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="22,20,22,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" CornerRadius="24" Background="#EAF3FC" Margin="0,0,12,0">
                    <TextBlock Text="👥" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding GroupHeader}" Style="{StaticResource EduSectionTitle}"/>
                    <TextBlock Text="{Binding EnrolledSummary}" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,10">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="250"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Padding="16,12" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                            <StackPanel>
                                <TextBlock Text="المسجلون في الفوج" Style="{StaticResource EduSubsectionTitle}"/>
                                <TextBlock Text="حدد طالباً للانسحاب أو النقل" Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1">
                            <DataGrid ItemsSource="{Binding Roster}" SelectedItem="{Binding SelectedEnrollment}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" VerticalGridLinesBrush="Transparent" BorderThickness="0" RowHeight="48" ColumnHeaderHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الطالب" Binding="{Binding FullName}" Width="1.7*"/>
                                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone, TargetNullValue='—'}" Width="*"/>
                                    <DataGridTextColumn Header="سعر الحصة" Binding="{Binding AgreedUnitPriceCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                                    <DataGridTextColumn Header="ملاحظة الخصم" Binding="{Binding DiscountNote, TargetNullValue='—'}" Width="*"/>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="لا يوجد مسجلون بعد" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding RosterEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        <Border Grid.Row="2" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="انسحاب من الفوج" Command="{Binding WithdrawCommand}" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,8,0"/>
                                <Button Content="نقل إلى فوج آخر" Command="{Binding TransferCommand}" Style="{StaticResource SecondaryButton}" Padding="14,7"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="إلحاق طالب جديد" Style="{StaticResource EduSubsectionTitle}"/>
                        <TextBlock Text="ابحث عن طالب ثم تحقق من تسجيله السنوي والسعر" Style="{StaticResource EduCaption}" Margin="0,3,0,12"/>
                        <StackPanel Visibility="{Binding HasNoPickedStudent, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBox Text="{Binding StudentSearchText, UpdateSourceTrigger=PropertyChanged}" Controls:TextBoxHelper.Watermark="ابحث بالاسم أو الهاتف…" Height="40" Padding="10,6"/>
                            <ListBox ItemsSource="{Binding StudentResults}" SelectedItem="{Binding PickedStudent}" DisplayMemberPath="FullName" MaxHeight="120" Margin="0,6,0,0" Visibility="{Binding ShowStudentResults, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasPickedStudent, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Background="{StaticResource PositiveSoftBrush}" BorderBrush="#B7DFB7" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PickedStudentName}" Style="{StaticResource EduBodyStrong}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="تغيير" Command="{Binding ClearPickedCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding AnnualStatusText}" Style="{StaticResource EduBodyMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button Content="إنشاء التسجيل السنوي" Command="{Binding CreateAnnualCommand}" Style="{StaticResource PrimaryButton}" Padding="14,7" HorizontalAlignment="Right" Margin="0,0,0,10" Visibility="{Binding ShowCreateAnnual, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <StackPanel Visibility="{Binding CanEnrollPicked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Background="#EEF5FC" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding SuggestedPriceText}" Style="{StaticResource EduCaption}" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,7,0">
                                        <TextBlock Text="سعر الحصة" Style="{StaticResource EduFieldLabel}"/>
                                        <TextBox Text="{Binding AgreedPriceText, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="7,0">
                                        <TextBlock Text="ملاحظة الخصم" Style="{StaticResource EduFieldLabel}"/>
                                        <TextBox Text="{Binding DiscountNote, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="7,0,0,0">
                                        <TextBlock Text="حصص مبدئية" Style="{StaticResource EduFieldLabel}"/>
                                        <TextBox Text="{Binding InitialSessionsText, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="إلحاق بالفوج" Command="{Binding EnrollCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <Button Grid.Column="1" Content="إغلاق" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" Padding="20,9"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>