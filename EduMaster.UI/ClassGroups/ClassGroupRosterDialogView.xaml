<UserControl x:Class="EduMaster.UI.ClassGroups.ClassGroupRosterDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- المحتوى: مسقوف بمرور داخلي (D-82) -->
            <RowDefinition Height="Auto"/>
            <!-- التذييل: مثبّت دائماً (D-41) -->
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="540">
            <StackPanel MinWidth="680">

                <!-- ترويسة الفوج -->
                <TextBlock Text="{Binding GroupHeader}" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="{Binding EnrolledSummary}" Foreground="Gray" Margin="0,2,0,8"/>

                <!-- قائمة المسجَّلين -->
                <DataGrid ItemsSource="{Binding Roster}" SelectedItem="{Binding SelectedEnrollment}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الطالب" Binding="{Binding FullName}" Width="2*"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone, TargetNullValue='—'}" Width="*"/>
                        <DataGridTextColumn Header="سعر الحصة المتفق" Binding="{Binding AgreedUnitPriceCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="*"/>
                        <DataGridTextColumn Header="ملاحظة خصم" Binding="{Binding DiscountNote, TargetNullValue='—'}" Width="*"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="لا مسجَّلين بعد — ألحق أول طالب من الأسفل" Foreground="Gray" FontSize="13"
                           Margin="0,4,0,0"
                           Visibility="{Binding RosterEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                    <Button Content="↩ انسحاب من الفوج" Command="{Binding WithdrawCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="🔀 نقل إلى فوج آخر" Command="{Binding TransferCommand}" Padding="12,6"/>
                </StackPanel>

                <!-- لوحة الإلحاق -->
                <Border Background="#F0F4FF" BorderBrush="#C7D4F5" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="إلحاق طالب بالفوج" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <!-- المنتقي: يختفي بعد الالتقاط، والنتائج لا تحجز مكاناً فارغاً (D-85) -->
                        <StackPanel Visibility="{Binding HasNoPickedStudent, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBox Text="{Binding StudentSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Controls:TextBoxHelper.Watermark="🔍 ابحث عن طالب بالاسم أو الهاتف…"
                                     Padding="8,6"/>
                            <ListBox ItemsSource="{Binding StudentResults}" SelectedItem="{Binding PickedStudent}"
                                     DisplayMemberPath="FullName" MaxHeight="110" Margin="0,4,0,0"
                                     BorderThickness="1" BorderBrush="#DDD"
                                     Visibility="{Binding ShowStudentResults, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- بطاقة الطالب الملتقط -->
                        <StackPanel Visibility="{Binding HasPickedStudent, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Background="#EAF6EA" BorderBrush="#B7DFB7" BorderThickness="1" CornerRadius="4"
                                    Padding="10,8" Margin="0,0,0,8">
                                <DockPanel>
                                    <Button Content="✕ تغيير" Command="{Binding ClearPickedCommand}" DockPanel.Dock="Left" Padding="10,4"/>
                                    <TextBlock Text="{Binding PickedStudentName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="{Binding AnnualStatusText}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <Button Content="📅 إنشاء التسجيل السنوي لهذه السنة" Command="{Binding CreateAnnualCommand}"
                                    Padding="12,6" HorizontalAlignment="Right" Margin="0,0,0,6"
                                    Visibility="{Binding ShowCreateAnnual, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- السعر + الحصص المبدئية — يظهران عند اكتمال الأهلية (D-77/D-97) -->
                            <StackPanel Visibility="{Binding CanEnrollPicked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding SuggestedPriceText}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="سعر الحصة المتفق (دج)" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding AgreedPriceText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="ملاحظة خصم (اختياري)" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DiscountNote, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="حصص مبدئية" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding InitialSessionsText, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="عرف الشهر = 4 حصص · 0 = بلا شراء الآن (تُشترى لاحقاً بزر «شراء حصص» من لوحة الطالب)"
                                           Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <Button Content="➕ إلحاق بالفوج" Command="{Binding EnrollCommand}"
                                        Padding="18,7" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- التذييل المثبّت: البانر + إغلاق -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إغلاق" Command="{Binding CloseCommand}" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>