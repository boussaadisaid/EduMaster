<UserControl x:Class="EduMaster.UI.ClassGroups.TransferGroupEnrollmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- الحقول: مسقوفة بمرور داخلي (D-82) -->
            <RowDefinition Height="Auto"/>
            <!-- التذييل: مثبّت دائماً (D-41) -->
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="480">
            <StackPanel MinWidth="620">

                <TextBlock Text="{Binding StudentName, StringFormat='الطالب: {0}'}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CurrentGroupName, StringFormat='من فوج: {0}'}" Foreground="Gray" Margin="0,2,0,10"/>

                <TextBlock Text="الأفواج المطابقة (نفس السنة والمستوى · الشعبة المناسبة · فعّالة · غير ممتلئة):"
                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DataGrid ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الفوج" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="المادة" Binding="{Binding SubjectName}" Width="*"/>
                        <DataGridTextColumn Header="الأستاذ" Binding="{Binding TeacherFullName, TargetNullValue='—'}" Width="*"/>
                        <DataGridTextColumn Header="الشعب" Binding="{Binding StreamsDisplay}" Width="*"/>
                        <DataGridTextColumn Header="المسجَّلون" Binding="{Binding EnrolledDisplay}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="لا أفواج مطابقة متاحة لهذا الطالب الآن" Foreground="Gray" FontSize="13"
                           Margin="0,6,0,0"
                           Visibility="{Binding TargetsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- السعر على الهدف (D-77) -->
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="{Binding SuggestedPriceText}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="سعر الحصة المتفق في الهدف (دج)" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AgreedPriceText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ملاحظة خصم (اختياري)" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DiscountNote, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- التذييل المثبّت: البانر + الأزرار -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="🔀 نقل" Command="{Binding SaveCommand}" Padding="22,8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>