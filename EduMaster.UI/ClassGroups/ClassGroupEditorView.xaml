<UserControl x:Class="EduMaster.UI.ClassGroups.ClassGroupEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- الحقول: تُمرَّر -->
            <RowDefinition Height="Auto"/>
            <!-- التذييل: مثبّت دائماً (D-41) -->
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel MinWidth="560">

                <!-- صف: السنة | المستوى — من الهوية، تُقفل في التحرير -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="السنة الدراسية *" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Years}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedYear}"
                                  IsEnabled="{Binding IsCreateMode}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="المستوى *" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Levels}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedLevel}"
                                  IsEnabled="{Binding IsCreateMode}"/>
                    </StackPanel>
                </Grid>

                <!-- صف: المادة | الأستاذ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="المادة *" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Subjects}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedSubject}"
                                  IsEnabled="{Binding IsCreateMode}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="الأستاذ (اختياري — يُسنَد لاحقاً)" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding TeacherOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedTeacher}"/>
                    </StackPanel>
                </Grid>

                <!-- صف: القاعة | السعة — اختياريان دائماً (D-44) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="القاعة (اختياري)" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding RoomOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedRoom}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="السعة (اختياري)" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CapacityText, UpdateSourceTrigger=PropertyChanged}"
                                 Controls:TextBoxHelper.Watermark="فارغ = بلا سقف"/>
                    </StackPanel>
                </Grid>

                <!-- شعب الفوج — تتجدد مع المستوى · فارغة = يقبل الكل (D-48) -->
                <StackPanel Visibility="{Binding ShowStreamsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="شعب الفوج" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="بلا تحديد = يقبل الفوج كل شعب المستوى" Foreground="Gray" FontSize="12" Margin="0,0,0,6"/>
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10"
                            Visibility="{Binding HasStreamOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding StreamOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Text="هذا المستوى بلا شعب فعّالة — يقبل الفوج الجميع" Foreground="Gray" Margin="0,0,0,10"
                               Visibility="{Binding ShowNoStreamsMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- الاسم — اقتراح تلقائي قابل للتعديل (D-58) -->
                <TextBlock Text="اسم الفوج *" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="يُقترح تلقائياً من المادة والمستوى ويمكن تعديله بحرية"
                           Foreground="Gray" FontSize="12" Margin="0,4,0,0"
                           Visibility="{Binding IsCreateMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- التذييل المثبّت: البانر + الأزرار -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="💾 حفظ" Command="{Binding SaveCommand}" Padding="22,8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>