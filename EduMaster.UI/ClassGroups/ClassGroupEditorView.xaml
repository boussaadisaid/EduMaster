<UserControl x:Class="EduMaster.UI.ClassGroups.ClassGroupEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls" FlowDirection="RightToLeft" Width="680" Height="650">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="22,20,22,16">
            <Border Width="48" Height="48" CornerRadius="24" Background="#EAF3FC" Margin="0,0,12,0">
                <TextBlock Text="👥" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource EduSectionTitle}"/>
                <TextBlock Text="تعريف هوية الفوج وتأطيره وسعته وشعبه" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,10">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="الهوية الأكاديمية" Style="{StaticResource EduSubsectionTitle}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,14">
                                <TextBlock Text="السنة الدراسية *" Style="{StaticResource EduFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Years}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedYear}" IsEnabled="{Binding IsCreateMode}" Height="40" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,14">
                                <TextBlock Text="المستوى *" Style="{StaticResource EduFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Levels}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedLevel}" IsEnabled="{Binding IsCreateMode}" Height="40" Padding="10,6"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="المادة *" Style="{StaticResource EduFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Subjects}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSubject}" IsEnabled="{Binding IsCreateMode}" Height="40" Padding="10,6"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="التأطير والتنظيم" Style="{StaticResource EduSubsectionTitle}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,14">
                                <TextBlock Text="الأستاذ الاختياري" Style="{StaticResource EduFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding TeacherOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTeacher}" Height="40" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,14">
                                <TextBlock Text="القاعة الاختيارية" Style="{StaticResource EduFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding RoomOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedRoom}" Height="40" Padding="10,6"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,0">
                                <TextBlock Text="اسم الفوج *" Style="{StaticResource EduFieldLabel}"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="السعة" Style="{StaticResource EduFieldLabel}"/>
                                <TextBox Text="{Binding CapacityText, UpdateSourceTrigger=PropertyChanged}" Controls:TextBoxHelper.Watermark="بلا سقف" Height="40" Padding="10,6"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="يُقترح الاسم تلقائياً من المادة والمستوى، ويمكن تعديله بحرية." Style="{StaticResource EduCaption}" Margin="0,6,0,0" Visibility="{Binding IsCreateMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Visibility="{Binding ShowStreamsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="شعب الفوج" Style="{StaticResource EduSubsectionTitle}"/>
                        <TextBlock Text="عدم تحديد أي شعبة يعني قبول جميع شعب المستوى." Style="{StaticResource EduCaption}" Margin="0,3,0,10"/>
                        <Border Background="#F7F9FC" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Visibility="{Binding HasStreamOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding StreamOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Text="هذا المستوى بلا شعب فعّالة؛ سيقبل الفوج الجميع." Style="{StaticResource EduBodyMuted}" Visibility="{Binding ShowNoStreamsMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="حفظ الفوج" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="20,9" Margin="0,0,8,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Padding="20,9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>