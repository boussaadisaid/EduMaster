<Window x:Class="EduMaster.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EduMaster.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="200" Width="500">
    <Grid>
        <StackPanel Orientation="Horizontal" Margin="12,12,12,0" Height="50" VerticalAlignment="Top">
            <Button Content="اضافة سنة دراسية" Margin="10" Command="{Binding OpenCreateAcademicYearDialogCommand}"/>
        </StackPanel>

        <TextBlock Text="{Binding ConnectionStatus}"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           FontSize="18" />

    </Grid>
</Window>
