<Controls:MetroWindow x:Class="EduMaster.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        Title="SchoolSys" Width="1150" Height="720"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">
    <Controls:MetroWindow.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Controls:MetroWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- القائمة الجانبية -->
        <Border Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="🏫 SchoolSys" FontSize="20" FontWeight="Bold" Margin="16,18,16,20"/>

                <Button Content="🏠  الرئيسية" Style="{StaticResource NavButton}"
                        Command="{Binding NavigateToHomeCommand}"/>

                <Button Content="👥  الأشخاص" Style="{StaticResource NavButton}"
                        Command="{Binding NavigateToPeopleCommand}"/>

                <Button Content="🎓  الطلاب" Style="{StaticResource NavButton}"
                        Command="{Binding NavigateToStudentsCommand}"/>

                <Button Content="👨‍🏫  الأساتذة" Style="{StaticResource NavButton}"
                        Command="{Binding NavigateToTeachersCommand}"/>

                <Button Content="🧑‍🤝‍🧑  الأفواج" Style="{StaticResource NavButton}"
                        Command="{Binding NavigateToClassGroupsCommand}"/>

                <Button Content="🗓  جدول استعمال الزمن" Style="{StaticResource NavButton}"
                        Command="{Binding NavigateToTimetableCommand}"/>

                <Button Content="✅  الحصص" Style="{StaticResource NavButton}"
                        Command="{Binding NavigateToSessionsCommand}"/>
                
                
                <Separator Margin="8,14"/>
                <TextBlock Text=" الإعدادات" Foreground="Gray" Margin="16,4,16,6"/>
                <Button Content="  السنوات الدراسية" Style="{StaticResource NavButton}"
Command="{Binding NavigateToAcademicYearsCommand}"/>
                <Button Content="  البنية الأكاديمية" Style="{StaticResource NavButton}"
Command="{Binding NavigateToAcademicStructureCommand}"/>
            </StackPanel>
        </Border>
        <!-- منطقة المحتوى: الشاشة تُحسم بنوع الـVM عبر DataTemplates -->
        <ContentPresenter Grid.Column="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Controls:MetroWindow>
