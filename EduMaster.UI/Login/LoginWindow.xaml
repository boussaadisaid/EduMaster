<mah:MetroWindow x:Class="EduMaster.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="SchoolSys — تسجيل الدخول"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        ShowTitleBar="False"
        ShowCloseButton="True"
        ShowMinButton="False"
        ShowMaxRestoreButton="False"
        ResizeMode="NoResize"
        Width="1000" Height="620" MinWidth="900" MinHeight="560">

    <mah:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </mah:MetroWindow.Resources>

    <Grid Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="55*"/>
        </Grid.ColumnDefinitions>

        <!-- جهة الهوية -->
        <Grid Grid.Column="0">
            <Border Background="#17212B">
                <Grid>
                    <Image Source="/EduMaster.UI;component/Assets/Images/school-login.jpg"
                           Stretch="UniformToFill"/>
                    <Border Background="#990F1720"/>
                    <StackPanel VerticalAlignment="Bottom" Margin="45">
                        <TextBlock Text="SchoolSys" FontSize="34" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="School Management System" FontSize="16" Margin="0,5,0,0" Foreground="#D5DCE3"/>
                        <Border Height="2" Width="55" HorizontalAlignment="Left" Background="#4FA3D1" Margin="0,18,0,18"/>
                        <TextBlock Text="إدارة أكاديمية أكثر ذكاءً وبساطة" FontSize="17" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- جهة الدخول -->
        <Grid Grid.Column="1" Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="55,45,55,0">
                <TextBlock Text="SchoolSys" FontSize="30" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Text="School Management System" FontSize="14" Opacity="0.65" Margin="0,2,0,0" TextAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="55,20,55,20">
                <StackPanel MaxWidth="420" Width="420" HorizontalAlignment="Center">

                    <TextBlock Text="مرحبًا بك" FontSize="28" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="سجّل الدخول للمتابعة إلى النظام" FontSize="14" Opacity="0.65"
                               Margin="0,7,0,32" TextAlignment="Center"/>

                    <!-- اسم المستخدم -->
                    <TextBlock Text="اسم المستخدم" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <TextBox x:Name="TxtUsername"
                             Height="42" FontSize="14" Padding="12,0"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                             mah:TextBoxHelper.Watermark="أدخل اسم المستخدم..."
                             mah:TextBoxHelper.ClearTextButton="True"/>

                    <!-- كلمة المرور -->
                    <TextBlock Text="كلمة المرور" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,7"/>
                    <PasswordBox x:Name="TxtPassword"
                                 Height="42" FontSize="14" Padding="12,0"
                                 mah:TextBoxHelper.Watermark="أدخل كلمة المرور..."
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <!-- بانر الخطأ -->
                    <Border Background="#FDECEA" BorderBrush="#E53E3E" BorderThickness="1"
                            CornerRadius="6" Padding="12,9" Margin="0,18,0,0"
                            Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="16" Height="16"
                                                        Foreground="#C53030" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C53030" FontSize="13"
                                       TextWrapping="Wrap" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- زر الدخول (بحلقة انتظار أثناء الفحص) -->
                    <Button Height="46" Margin="0,25,0,0" FontSize="15" FontWeight="SemiBold"
                            Command="{Binding LoginCommand}" IsDefault="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Square.Accent}">
                                <Setter Property="Content" Value="تسجيل الدخول"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoggingIn}" Value="True">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <mah:ProgressRing Width="20" Height="20" IsActive="True" Foreground="White"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- حالة قاعدة البيانات -->
                    <Border Margin="0,20,0,0" Padding="12,9" CornerRadius="4"
                            BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray5}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <mah:ProgressRing Width="14" Height="14" Margin="0,0,8,0"
                                              IsActive="{Binding IsCheckingConnection}"
                                              Visibility="{Binding IsCheckingConnection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#DD6B20"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCheckingConnection}" Value="False"/>
                                                    <Condition Binding="{Binding IsConnected}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Fill" Value="#38A169"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCheckingConnection}" Value="False"/>
                                                    <Condition Binding="{Binding IsConnected}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Fill" Value="#E53E3E"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionStatusMessage}" FontSize="12" Opacity="0.85"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280"/>
                            <Button Content="إعادة المحاولة" Command="{Binding RetryConnectionCommand}"
                                    FontSize="11" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding ShowRetry, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="2" Text="SchoolSys v1.0.0" FontSize="11" Opacity="0.45"
                       HorizontalAlignment="Center" Margin="0,0,0,22"/>
        </Grid>
    </Grid>
</mah:MetroWindow>