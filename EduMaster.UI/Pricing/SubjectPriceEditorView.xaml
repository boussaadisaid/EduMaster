<UserControl x:Class="EduMaster.UI.Pricing.SubjectPriceEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="600" Height="490">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,20,22,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,0,2,18">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#EAF3FC" Margin="0,0,12,0">
                        <TextBlock Text="💳" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource EduSectionTitle}"/>
                        <TextBlock Text="تحديد سعر الحصة حسب السنة والمستوى والمادة" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="هوية السعر" Style="{StaticResource EduSubsectionTitle}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,14">
                                <TextBlock Text="السنة الدراسية *" Style="{StaticResource EduFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Years}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedYear}" IsEnabled="{Binding IsCreateMode}" Height="40" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,14">
                                <TextBlock Text="المستوى *" Style="{StaticResource EduFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Levels}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedLevel}" IsEnabled="{Binding IsCreateMode}" Height="40" Padding="10,6"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="المادة *" Style="{StaticResource EduFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Subjects}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSubject}" IsEnabled="{Binding IsCreateMode}" Height="40" Padding="10,6"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="سعر الحصة" Style="{StaticResource EduSubsectionTitle}"/>
                        <TextBlock Text="المبلغ بالدينار *" Style="{StaticResource EduFieldLabel}" Margin="0,12,0,0"/>
                        <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        <TextBlock Text="يمكن إدخال 0 لسعر مجاني صريح. يُقترح السعر عند التسجيل ويُنسخ لكل طالب." Style="{StaticResource EduCaption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#EEF5FC" BorderBrush="#D5E5F4" BorderThickness="1" CornerRadius="8" Padding="12,9">
                    <TextBlock Text="عند تعديل سعر قائم تبقى السنة والمستوى والمادة مقفلة، ويتغير المبلغ فقط." Style="{StaticResource EduCaption}" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="حفظ" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="20,9" Margin="0,0,8,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Padding="20,9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>