<UserControl x:Class="EduMaster.UI.Reports.StudentStatementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls" xmlns:common="clr-namespace:EduMaster.UI.Common" FlowDirection="RightToLeft">
    <UserControl.Resources>
        <common:CentimesToDinarsConverter x:Key="StudentStatementCentimesToDinarsConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="اختيار الطالب" Style="{StaticResource EduSubsectionTitle}"/>
                    <TextBlock Text="ابحث بالاسم أو رقم الهاتف" Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Controls:TextBoxHelper.Watermark="ابحث عن طالب…" Height="40" Padding="10,6" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="نطاق كشف الحساب" Style="{StaticResource EduFieldLabel}" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" DisplayMemberPath="Title" Height="40"/>
                </StackPanel>
                <ListBox Grid.Row="3" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedStudent}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding FullName}" Style="{StaticResource EduBodyStrong}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Phone, TargetNullValue='—'}" Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#F7F9FC" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,10" Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedStudent.FullName}" Style="{StaticResource EduSectionTitle}"/>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding SelectedStudent.CategoryText}" Style="{StaticResource EduCaption}" Margin="0,0,14,0"/>
                            <TextBlock Text="{Binding SelectedStudent.Phone, TargetNullValue='—'}" Style="{StaticResource EduCaption}" Margin="0,0,14,0"/>
                            <TextBlock Text="الولي: " Style="{StaticResource EduCaption}"/>
                            <TextBlock Text="{Binding SelectedStudent.GuardianFullName, TargetNullValue='—'}" Style="{StaticResource EduCaption}"/>
                        </WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="طباعة كشف الحساب" Command="{Binding PrintCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="9" Padding="14,9" Margin="0,0,0,10" Visibility="{Binding HasStatement, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding TotalsText}" Foreground="{StaticResource NegativeBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
            <Border Grid.Row="2" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="14,9">
                        <TextBlock Text="المستحقات والتسويات" Style="{StaticResource EduSubsectionTitle}"/>
                    </Border>
                    <Grid Grid.Row="1">
                        <DataGrid ItemsSource="{Binding Statement.Charges}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="النوع" Binding="{Binding KindText}" Width="Auto"/>
                                <DataGridTextColumn Header="الوصف" Binding="{Binding SourceDescription}" Width="2*"/>
                                <DataGridTextColumn Header="الأصلي" Binding="{Binding OriginalAmountCentimes, Converter={StaticResource StudentStatementCentimesToDinarsConverter}}" Width="Auto"/>
                                <DataGridTextColumn Header="الحالي" Binding="{Binding AmountCentimes, Converter={StaticResource StudentStatementCentimesToDinarsConverter}}" Width="Auto"/>
                                <DataGridTextColumn Header="المخصص" Binding="{Binding AllocatedCentimes, Converter={StaticResource StudentStatementCentimesToDinarsConverter}}" Width="Auto"/>
                                <DataGridTemplateColumn Header="المتبقي" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RemainingForDisplayCentimes, Converter={StaticResource StudentStatementCentimesToDinarsConverter}, TargetNullValue='—'}" Foreground="{StaticResource NegativeBrush}" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="Auto"/>
                                <DataGridTextColumn Header="سبب التسوية" Binding="{Binding AdjustmentNote, TargetNullValue='—'}" Width="*"/>
                                <DataGridTextColumn Header="أُنشئ" Binding="{Binding CreatedAtUtc, StringFormat='yyyy-MM-dd'}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="لا توجد مستحقات لهذا الطالب" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoCharges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock Grid.Row="3" Text="الإيصالات وتخصيصاتها" Style="{StaticResource EduSubsectionTitle}" Margin="0,12,0,7" Visibility="{Binding HasStatement, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Border Grid.Row="4" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <DataGrid ItemsSource="{Binding Statement.Payments}" SelectedItem="{Binding SelectedPayment}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="إيصال" Binding="{Binding ReceiptNoText}" Width="Auto"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding PaidOn, StringFormat='yyyy-MM-dd'}" Width="Auto"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding KindText}" Width="Auto"/>
                            <DataGridTextColumn Header="الدافع" Binding="{Binding PayerName, TargetNullValue='—'}" Width="*"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountCentimes, Converter={StaticResource StudentStatementCentimesToDinarsConverter}}" Width="Auto"/>
                            <DataGridTextColumn Header="المخصص للسنة" Binding="{Binding AllocatedToSelectedAcademicYearCentimes, Converter={StaticResource StudentStatementCentimesToDinarsConverter}}" Width="Auto"/>
                            <DataGridTemplateColumn Header="التخصيص" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ItemsControl ItemsSource="{Binding Allocations}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="• "/>
                                                            <TextBlock Text="{Binding SourceDescription}"/>
                                                            <TextBlock Text=": "/>
                                                            <TextBlock Text="{Binding AmountCentimes, Converter={StaticResource StudentStatementCentimesToDinarsConverter}}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="—" Foreground="{StaticResource TextMutedBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Allocations.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style></TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ملاحظة" Binding="{Binding Note, TargetNullValue='—'}" Width="*"/>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="طباعة" Style="{StaticResource SecondaryButton}" Padding="9,4" Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="لا توجد إيصالات لهذا الطالب" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoPayments, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="0" Grid.RowSpan="5" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="👤" FontSize="34" HorizontalAlignment="Center"/>
                <TextBlock Text="اختر طالباً لعرض كشف حسابه" Style="{StaticResource EduBodyStrong}" Margin="0,9,0,0"/>
                <TextBlock Text="استخدم البحث في القائمة الجانبية" Style="{StaticResource EduCaption}" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Row="0" Grid.RowSpan="5" Background="#CCFFFFFF" Visibility="{Binding IsLoadingStatement, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="جارٍ تحميل كشف الحساب…" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>