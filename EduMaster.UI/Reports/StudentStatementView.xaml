<UserControl x:Class="EduMaster.UI.Reports.StudentStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- منتقي الطالب -->
        <StackPanel>
            <TextBlock Text="كشف حساب طالب" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Controls:TextBoxHelper.Watermark="🔍 بالاسم أو الهاتف…"
                     Padding="8,5"/>
            <ListBox ItemsSource="{Binding SearchResults}"
                     SelectedItem="{Binding SelectedStudent}"
                     Height="260" Margin="0,8,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Phone, TargetNullValue='—'}" Foreground="Gray" FontSize="12"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- الكشف -->
        <Grid Grid.Column="1" Margin="24,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- الترويسة: من سطر الطالب المحدَّد مباشرةً — و6.3 (ط-هـ): زر 🖨 يطبع الكشف المعروض -->
            <Border Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="#F3F3F3" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                <DockPanel>
                    <Button Content="🖨 طباعة" Command="{Binding PrintCommand}" DockPanel.Dock="Left"
                            Padding="14,6" VerticalAlignment="Center"
                            ToolTip="طباعة كشف الحساب المعروض"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedStudent.FullName}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedStudent.CategoryText}" Foreground="Gray" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <TextBlock Text="{Binding SelectedStudent.Phone, TargetNullValue='—'}" Foreground="Gray" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="الولي: " Foreground="Gray"/>
                            <TextBlock Text="{Binding SelectedStudent.GuardianFullName, TargetNullValue='—'}" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="1" Text="{Binding TotalsText}" Foreground="#C42B1C" FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Visibility="{Binding HasStatement, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- المستحقات بأسباب تسوياتها (D-108) -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Statement.Charges}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="النوع" Binding="{Binding KindText}" Width="Auto"/>
                    <DataGridTextColumn Header="الوصف" Binding="{Binding SourceDescription}" Width="2*"/>
                    <DataGridTextColumn Header="الأصلي" Binding="{Binding OriginalAmountCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                    <DataGridTextColumn Header="الحالي" Binding="{Binding AmountCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                    <DataGridTextColumn Header="المخصوص" Binding="{Binding AllocatedCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                    <DataGridTemplateColumn Header="المتبقي" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RemainingForDisplayCentimes, Converter={StaticResource CentimesToDinarsConverter}, TargetNullValue='—'}"
                                           Foreground="#C42B1C" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="Auto"/>
                    <DataGridTextColumn Header="سبب التسوية" Binding="{Binding AdjustmentNote, TargetNullValue='—'}" Width="*"/>
                    <DataGridTextColumn Header="أُنشئ" Binding="{Binding CreatedAtUtc, StringFormat='yyyy-MM-dd'}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="2" Text="لا مستحقات لهذا الطالب"
                       Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasNoCharges, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Grid.Row="3" Text="الإيصالات وتخصيصاتها" FontWeight="SemiBold" Margin="0,12,0,6"
                       Visibility="{Binding HasStatement, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <DataGrid Grid.Row="4"
                      ItemsSource="{Binding Statement.Payments}"
                      SelectedItem="{Binding SelectedPayment}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="إيصال" Binding="{Binding ReceiptNoText}" Width="Auto"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding PaidOn, StringFormat='yyyy-MM-dd'}" Width="Auto"/>
                    <DataGridTemplateColumn Header="النوع" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding KindText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KindText}" Value="صرف">
                                                    <Setter Property="Foreground" Value="#B26B00"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="الدافع" Binding="{Binding PayerName, TargetNullValue='—'}" Width="*"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                    <DataGridTemplateColumn Header="التخصيص" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding Allocations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="• "/>
                                                    <TextBlock Text="{Binding SourceDescription}"/>
                                                    <TextBlock Text=": "/>
                                                    <TextBlock Text="{Binding AmountCentimes, Converter={StaticResource CentimesToDinarsConverter}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="—" Foreground="Gray">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Allocations.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ملاحظة" Binding="{Binding Note, TargetNullValue='—'}" Width="*"/>
                    <!-- 6.3 (ط-هـ تتمة): 🖨 على سطر إيصال الكشف — إعادة طباعة أي إيصال من موضع قراءته (بلا بوابة: النقرة الأولى تحدّد السطر) -->
                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🖨" ToolTip="طباعة الإيصال" Padding="8,2" VerticalAlignment="Center"
                                        Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="4" Text="لا إيصالات لهذا الطالب"
                       Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasNoPayments, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- حالتا الفراغ والتحميل -->
            <TextBlock Grid.Row="0" Grid.RowSpan="5" Text="اختر طالباً من القائمة لعرض كشف حسابه"
                       Foreground="Gray" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Grid.Row="0" Grid.RowSpan="5" Text="جارٍ تحميل الكشف…" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsLoadingStatement, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>