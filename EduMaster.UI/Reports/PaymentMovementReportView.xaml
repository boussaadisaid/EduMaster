<UserControl x:Class="EduMaster.UI.Reports.PaymentMovementReportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="حركة القبض والصرف" Style="{StaticResource EduSectionTitle}"/>
                <TextBlock Text="الإيصالات والمبالغ المصروفة والصافي خلال الفترة المحددة" Style="{StaticResource EduBodyMuted}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="طباعة التقرير" Command="{Binding PrintCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="من تاريخ" Style="{StaticResource EduFieldLabel}"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Height="38"/>
                </StackPanel>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="السنة المرجعية" Style="{StaticResource EduFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding AcademicYears}"
                              SelectedItem="{Binding SelectedAcademicYear}"
                              DisplayMemberPath="Name"
                              Height="38"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="من تاريخ" Style="{StaticResource EduFieldLabel}"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Height="38"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="إلى تاريخ" Style="{StaticResource EduFieldLabel}"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Height="38"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#EEF5FC" BorderBrush="#D5E5F4" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="14,10">
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource EduBodyStrong}" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap"/>
                </Border>
                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" VerticalGridLinesBrush="Transparent" BorderThickness="0" RowHeight="46" ColumnHeaderHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الإيصال" Binding="{Binding ReceiptNoText}" Width="Auto"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding PaidOn, StringFormat='yyyy-MM-dd'}" Width="Auto"/>
                            <DataGridTextColumn Header="الطالب" Binding="{Binding StudentName}" Width="2*"/>
                            <DataGridTextColumn Header="الدافع" Binding="{Binding PayerName, TargetNullValue='—'}" Width="*"/>
                            <DataGridTemplateColumn Header="النوع" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="9" Padding="9,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource PositiveSoftBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding KindText}" Value="صرف">
                                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding KindText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource PositiveBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding KindText}" Value="صرف">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style></TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                            <DataGridTemplateColumn Header="غير مخصص" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UnallocatedCentimes, Converter={StaticResource CentimesToDinarsConverter}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUnallocated}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style></TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ملاحظة" Binding="{Binding Note, TargetNullValue='—'}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="📊" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="لا توجد حركة مالية في هذه الفترة" Style="{StaticResource EduBodyStrong}" Margin="0,7,0,0"/>
                        <TextBlock Text="غيّر الفلاتر أو الفترة ثم أعد المحاولة" Style="{StaticResource EduCaption}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Background="#CCFFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="جارٍ تحميل التقرير…" Style="{StaticResource EduBodyMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>