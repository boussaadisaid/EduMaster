<UserControl x:Class="EduMaster.UI.Reports.LowSessionBalancesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="تنبيه نفاد أرصدة الحصص" Style="{StaticResource EduSectionTitle}"/>
                <TextBlock Text="الأرصدة الأقرب إلى النفاد أولاً، والسالب يعني تجاوز الرصيد" Style="{StaticResource EduBodyMuted}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="طباعة ورقة الاتصالات" Command="{Binding PrintCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="التنبيه عندما يكون الرصيد ≤" Style="{StaticResource EduFieldLabel}"/>
                    <TextBox Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}" Height="38" Width="90" HorizontalAlignment="Right" TextAlignment="Center" Padding="8,5"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="12,8" Margin="14,0,0,0" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="2" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="10">
            <Grid>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" VerticalGridLinesBrush="Transparent" BorderThickness="0" RowHeight="48" ColumnHeaderHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الطالب" Binding="{Binding StudentName}" Width="2*"/>
                        <DataGridTextColumn Header="الفوج" Binding="{Binding GroupName}" Width="*"/>
                        <DataGridTextColumn Header="المادة" Binding="{Binding SubjectName}" Width="*"/>
                        <DataGridTemplateColumn Header="الرصيد" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9" Padding="10,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNegative}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource NegativeSoftBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Balance}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNegative}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource NegativeBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style></TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="جهة التذكير" Binding="{Binding ContactName}" Width="*"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding ContactPhone, TargetNullValue='—'}" Width="Auto"/>
                        <DataGridTemplateColumn Header="التواصل" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="واتساب" Style="{StaticResource SecondaryButton}" Padding="10,5" Command="{Binding DataContext.OpenWhatsAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="✓" FontSize="30" Foreground="{StaticResource PositiveBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="كل الأرصدة فوق العتبة" Style="{StaticResource EduBodyStrong}" Margin="0,7,0,0"/>
                    <TextBlock Text="لا توجد تنبيهات حالياً" Style="{StaticResource EduCaption}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Background="#CCFFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="جارٍ تحميل الأرصدة…" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>