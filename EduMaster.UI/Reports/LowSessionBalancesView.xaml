<UserControl x:Class="EduMaster.UI.Reports.LowSessionBalancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="{Binding SummaryText}" DockPanel.Dock="Left" Foreground="Gray" VerticalAlignment="Center"/>
            <TextBlock Text="تنبيه نفاد أرصدة الحصص — الأنفد أولاً (السالب = تجاوز)" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="الرصيد ≤" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}" Width="56" TextAlignment="Center"/>
            </StackPanel>
            <Button Content="🔄 تحديث" Command="{Binding RefreshCommand}" Margin="14,0,0,0" Padding="14,6"/>
            <!-- 6.4 (ق-6): ورقة الاتصالات — تُفعَّل بعد أول تحميل ناجح غير فارغ -->
            <Button Content="🖨 طباعة" Command="{Binding PrintCommand}" Margin="8,0,0,0" Padding="14,6"/>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الطالب" Binding="{Binding StudentName}" Width="2*"/>
                <DataGridTextColumn Header="الفوج" Binding="{Binding GroupName}" Width="*"/>
                <DataGridTextColumn Header="المادة" Binding="{Binding SubjectName}" Width="*"/>
                <DataGridTemplateColumn Header="الرصيد" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Balance}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNegative}" Value="True">
                                                <Setter Property="Foreground" Value="#C42B1C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="جهة التذكير" Binding="{Binding ContactName}" Width="*"/>
                <DataGridTextColumn Header="الهاتف" Binding="{Binding ContactPhone, TargetNullValue='—'}" Width="Auto"/>
                <DataGridTemplateColumn Header="تذكير" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- 💬 واتساب برسالة جاهزة (ق-9) — بلا هاتف صالح يتعطّل الزر -->
                            <Button Content="💬 واتساب" Padding="8,3"
                                    Command="{Binding DataContext.OpenWhatsAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="1" Text="لا تنبيهات — كل الأرصدة فوق العتبة ✔"
                   Foreground="Gray" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <TextBlock Grid.Row="1" Text="جارٍ التحميل…" Foreground="Gray"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
