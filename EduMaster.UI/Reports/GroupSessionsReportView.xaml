<UserControl x:Class="EduMaster.UI.Reports.GroupSessionsReportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="حصص الأفواج" Style="{StaticResource EduSectionTitle}"/>
                <TextBlock Text="مقارنة الحصص المجدولة والمقامة والملغاة وساعات العمل" Style="{StaticResource EduBodyMuted}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="طباعة التقرير" Command="{Binding PrintCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="من تاريخ" Style="{StaticResource EduFieldLabel}"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Height="38"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="إلى تاريخ" Style="{StaticResource EduFieldLabel}"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Height="38"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="الفوج" Style="{StaticResource EduFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" Height="38" MinWidth="220" Padding="8,5"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#EEF5FC" BorderBrush="#D5E5F4" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="14,10">
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource EduBodyStrong}" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap"/>
                </Border>
                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" VerticalGridLinesBrush="Transparent" BorderThickness="0" RowHeight="46" ColumnHeaderHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الفوج" Binding="{Binding GroupName}" Width="*"/>
                            <DataGridTextColumn Header="المادة" Binding="{Binding SubjectName}" Width="*"/>
                            <DataGridTextColumn Header="المستوى" Binding="{Binding LevelName}" Width="Auto"/>
                            <DataGridTextColumn Header="الأستاذ" Binding="{Binding TeacherName, TargetNullValue='—'}" Width="*"/>
                            <DataGridTextColumn Header="مجدولة" Binding="{Binding ScheduledCount}" Width="Auto"/>
                            <DataGridTextColumn Header="مُقامة" Binding="{Binding HeldCount}" Width="Auto"/>
                            <DataGridTextColumn Header="ملغاة" Binding="{Binding CancelledCount}" Width="Auto"/>
                            <DataGridTextColumn Header="ساعات مُقامة" Binding="{Binding HeldHoursText}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="📊" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="لا توجد حصص في هذه الفترة" Style="{StaticResource EduBodyStrong}" Margin="0,7,0,0"/>
                        <TextBlock Text="غيّر الفلاتر أو الفترة ثم أعد المحاولة" Style="{StaticResource EduCaption}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Background="#CCFFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="جارٍ تحميل التقرير…" Style="{StaticResource EduBodyMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>