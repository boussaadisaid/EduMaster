<UserControl x:Class="EduMaster.UI.Reports.GroupSessionsReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="{Binding SummaryText}" DockPanel.Dock="Left" Foreground="Gray" VerticalAlignment="Center"/>
            <TextBlock Text="حصص الأفواج — مُقامة/مجدولة/ملغاة (الملغاة لا دقائق لها)" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="120"/>
                <TextBlock Text="إلى" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="120"/>
                <TextBlock Text="الفوج" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <ComboBox ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding SelectedGroup}"
                          DisplayMemberPath="Name" MinWidth="180"/>
            </StackPanel>
            <Button Content="🔄 تحديث" Command="{Binding RefreshCommand}" Margin="14,0,0,0" Padding="14,6"/>
            <!-- 6.4 (ق-6): طباعة التقرير المعروض حرفياً (WYSIWYP) بترويسة الهوية — تُفعَّل بعد أول تحميل ناجح -->
            <Button Content="🖨 طباعة" Command="{Binding PrintCommand}" Margin="8,0,0,0" Padding="14,6"/>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الفوج" Binding="{Binding GroupName}" Width="*"/>
                <DataGridTextColumn Header="المادة" Binding="{Binding SubjectName}" Width="*"/>
                <DataGridTextColumn Header="المستوى" Binding="{Binding LevelName}" Width="Auto"/>
                <DataGridTextColumn Header="الأستاذ" Binding="{Binding TeacherName, TargetNullValue='—'}" Width="*"/>
                <DataGridTextColumn Header="مجدولة" Binding="{Binding ScheduledCount}" Width="Auto"/>
                <DataGridTextColumn Header="مُقامة" Binding="{Binding HeldCount}" Width="Auto"/>
                <DataGridTextColumn Header="ملغاة" Binding="{Binding CancelledCount}" Width="Auto"/>
                <DataGridTextColumn Header="ساعات مُقامة" Binding="{Binding HeldHoursText}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="1" Text="لا حصص في هذه الفترة"
                   Foreground="Gray" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <TextBlock Grid.Row="1" Text="جارٍ التحميل…" Foreground="Gray"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
