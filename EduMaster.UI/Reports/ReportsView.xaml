<UserControl x:Class="EduMaster.UI.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- قائمة التقارير -->
        <StackPanel>
            <TextBlock Text="📊 التقارير" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <ListBox ItemsSource="{Binding Reports}"
                     SelectedItem="{Binding SelectedReport}"
                     DisplayMemberPath="Title"
                     FontSize="14" Padding="4"/>
        </StackPanel>

        <!-- منطقة التقرير: يُحسم بنوع الـVM عبر DataTemplates -->
        <ContentPresenter Grid.Column="1" Content="{Binding CurrentReport}" Margin="24,0,0,0"/>
    </Grid>
</UserControl>