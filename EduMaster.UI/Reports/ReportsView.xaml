<UserControl x:Class="EduMaster.UI.Reports.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <UserControl.Resources>
        <Style x:Key="ReportNavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF5FC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F0FC"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="التقارير" Style="{StaticResource EduPageTitle}"/>
            <TextBlock Text="قراءة وتحليل البيانات الأكاديمية والمالية مع خيارات الطباعة" Style="{StaticResource EduBodyMuted}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="8,6,8,14">
                        <TextBlock Text="مركز التقارير" Style="{StaticResource EduSubsectionTitle}"/>
                        <TextBlock Text="اختر التقرير المطلوب" Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" DisplayMemberPath="Title" ItemContainerStyle="{StaticResource ReportNavItem}" BorderThickness="0" Background="Transparent"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18">
                <ContentPresenter Content="{Binding CurrentReport}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>