<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:EduMaster.UI.Common.Converters">
    <!-- F7 — اللغة البصرية المشتركة لـEduMaster: تُستعمل في الرئيسية أولاً ثم تُعمَّم مع شرائح التحسين -->
    <converters:ScreenKeyEqualityConverter x:Key="ScreenKeyEqualityConverter"/>

    <!-- الألوان المرجعية -->
    <Color x:Key="AccentColor">#2E86DE</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#2570BE"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#1F2A3A"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#28374D"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#2A3A52"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#D9E1EC"/>
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#7E8CA3"/>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E8F0"/>

    <!-- بند التنقل الجانبي: مسطّح + لسان لوني للنشط (Tag = مفتاح الشاشة) + هوفر ناعم -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="10,1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="activeBar" Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                    CornerRadius="2" Background="{StaticResource AccentBrush}" Visibility="Collapsed"
                                    Margin="0,4"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                        </Trigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource ScreenKeyEqualityConverter}">
                                    <Binding Path="DataContext.CurrentScreenKey" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="activeBar" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- عنوان مجموعة في الشريط الجانبي -->
    <Style x:Key="NavGroupHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="18,14,18,6"/>
    </Style>

    <!-- بطاقة المحتوى -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#1F2A3A" Opacity="0.08" BlurRadius="14" ShadowDepth="2" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- الأزرار المرجعية (فوق MahApps — تحسين موضعي لا ثورة ثيم) -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,7"/>
    </Style>
</ResourceDictionary>
