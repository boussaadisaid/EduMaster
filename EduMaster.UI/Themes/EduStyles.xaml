<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:EduMaster.UI.Common.Converters">
    <!-- F7 — اللغة البصرية المشتركة لـEduMaster: تُستعمل في الرئيسية أولاً ثم تُعمَّم مع شرائح التحسين -->
    <converters:ScreenKeyEqualityConverter x:Key="ScreenKeyEqualityConverter"/>

    <!--
    ══════════════════════════════════════════════════════════════════════════
    F7 · عائلات الخط — محقَّقة من جدول الأسماء الداخلي للملفات (fontTools + fc-scan)
      Cairo-Regular.ttf  → Family(ID1)="Cairo"          · Subfamily="Regular" · usWeightClass=400
      Cairo-Bold.ttf     → Family(ID1)="Cairo"          · Subfamily="Bold"    · usWeightClass=700
      Cairo-SemiBold.ttf → Family(ID1)="Cairo SemiBold" · Subfamily="Regular" · usWeightClass=600
    ⚠ ملف SemiBold عائلة مستقلة، فلا يُطلب بـFontWeight على عائلة "Cairo" بل بمفتاحه الخاص.
    موقعهما في أعلى القاموس متعمّد: StaticResource يحلّ للخلف فقط، والأنماط أدناه تستهلكهما.
    ══════════════════════════════════════════════════════════════════════════
    -->
    <FontFamily x:Key="EduFontRegular">pack://application:,,,/Fonts/#Cairo</FontFamily>
    <FontFamily x:Key="EduFontSemiBold">pack://application:,,,/Fonts/#Cairo SemiBold</FontFamily>

    <!-- الألوان المرجعية -->
    <Color x:Key="AccentColor">#2E86DE</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#2570BE"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#1F2A3A"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#28374D"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#2A3A52"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#D9E1EC"/>
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#7E8CA3"/>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E8F0"/>

    <!-- فُرش النصوص -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2A3A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6B82"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A97A8"/>

    <!-- الفُرش الدلالية — #C42B1C هي نفسها المستعملة اليوم في StudentStatementView (D-92/D-98) -->
    <SolidColorBrush x:Key="NegativeBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="PositiveBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B7791F"/>
    <SolidColorBrush x:Key="NegativeSoftBrush" Color="#FDECEA"/>
    <SolidColorBrush x:Key="PositiveSoftBrush" Color="#EAF6EA"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FDF6E3"/>

    <!-- بند التنقل الجانبي: مسطّح + لسان لوني للنشط (Tag = مفتاح الشاشة) + هوفر ناعم -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="10,1"/>
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="activeBar" Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                    CornerRadius="2" Background="{StaticResource AccentBrush}" Visibility="Collapsed"
                                    Margin="0,4"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                        </Trigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource ScreenKeyEqualityConverter}">
                                    <Binding Path="DataContext.CurrentScreenKey" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="activeBar" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- عنوان مجموعة في الشريط الجانبي -->
    <Style x:Key="NavGroupHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource EduFontSemiBold}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Margin" Value="18,14,18,6"/>
    </Style>

    <!-- بطاقة المحتوى -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#1F2A3A" Opacity="0.08" BlurRadius="14" ShadowDepth="2" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- الأزرار المرجعية (فوق MahApps — تحسين موضعي لا ثورة ثيم) -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="FontFamily" Value="{StaticResource EduFontSemiBold}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>

    <!--
    سُلّم الطباعة النصية — مقاسات مأخوذة من شاشاتك كما هي فلا تقع إزاحة تخطيط
    (28 · 24 · 17 · 15 · 14 · 13 · 11.5)
    -->
    <Style x:Key="EduPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EduFontSemiBold}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="EduHeroTitle" TargetType="TextBlock" BasedOn="{StaticResource EduPageTitle}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="28"/>
    </Style>
    <Style x:Key="EduSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EduFontSemiBold}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="EduSubsectionTitle" TargetType="TextBlock" BasedOn="{StaticResource EduSectionTitle}">
        <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="EduBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="EduBodyStrong" TargetType="TextBlock" BasedOn="{StaticResource EduBody}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontSemiBold}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="EduBodyMuted" TargetType="TextBlock" BasedOn="{StaticResource EduBody}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="EduFieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EduFontSemiBold}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="EduCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>

    <!--
    ══════════════════════════════════════════════════════════════════════════
    حقن الخط في الكونترولز — أنماط ضمنية (بلا x:Key) تبني على نمط MahApps وتضبط FontFamily وحدها.
    قاعدة الأسبقية التي تفسر كل حالات «بعضه كايرو وبعضه لا»:
      قيمة محلية على العنصر  >  Setter في النمط المطبّق  >  التوريث من الأب
    فأي عنصر يحمل Style صريحاً يتجاوز النمط الضمني تماماً، ومن هنا كانت الثغرات.
    ══════════════════════════════════════════════════════════════════════════
    -->
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>
    <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource {x:Type PasswordBox}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>
    <Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource {x:Type DatePicker}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>
    <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>
    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>
    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource {x:Type TabControl}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>
    <!--
    التابات: نص العنوان يُرسم داخل قالب MahApps نفسه، فلا يبلغه Setter خارجي.
    الحل الذي لا يتوقف على داخليات المكتبة: نملك قالب العنوان نفسه، والقيمة المحلية
    على الـTextBlock تتقدم على أي شيء يفعله القالب داخلاً.
    محقّق: الـTabItem الثمانية في المشروع (الأجور 2 + البنية الأكاديمية 6) عناوينها نصوص بسيطة
    لا عناصر مركّبة، فـBinding المباشر كافٍ ولا يفقد شيئاً. اللون والمقاس يُتركان للتوريث
    فتبقى ألوان MahApps للتبويب المحدّد/الممرّر عليه كما هي.
    -->
    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontFamily="{StaticResource EduFontSemiBold}"
                               FontWeight="Normal"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- الداتاغريد: الجسم والرأس والخلايا أنواع مستقلة — ورأس الأعمدة هو ما بقي بالخط الافتراضي -->
    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>
    <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontSemiBold}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style TargetType="{x:Type DataGridRowHeader}" BasedOn="{StaticResource {x:Type DataGridRowHeader}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>
    <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>
    <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="FontFamily" Value="{StaticResource EduFontRegular}"/>
    </Style>
</ResourceDictionary>
