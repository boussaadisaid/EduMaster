<UserControl x:Class="EduMaster.UI.Dialogs.ConfirmDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24" MinWidth="340" MaxWidth="460">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
            <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Padding="20,6" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Command="{Binding CancelCommand}" Padding="20,6"/>
        </StackPanel>
    </StackPanel>
</UserControl>