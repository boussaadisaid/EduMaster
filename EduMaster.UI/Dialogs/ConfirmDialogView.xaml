<UserControl x:Class="EduMaster.UI.Dialogs.ConfirmDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="500">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="22,20,22,14">
            <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource WarningSoftBrush}" Margin="0,0,12,0">
                <TextBlock Text="!" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="تأكيد الإجراء" Style="{StaticResource EduSectionTitle}"/>
                <TextBlock Text="راجع التفاصيل قبل المتابعة" Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="22,0,22,18">
            <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Message}" Style="{StaticResource EduBody}" TextWrapping="Wrap" LineHeight="23"/>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" MinWidth="118" Padding="18,8" Margin="0,0,8,0" IsDefault="True"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" MinWidth="104" Padding="18,8"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>