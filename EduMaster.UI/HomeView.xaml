<UserControl x:Class="EduMaster.UI.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="34" MaxWidth="880" HorizontalAlignment="Center">
            <StackPanel>
                <Border Width="76" Height="76" CornerRadius="38" Background="#EAF3FC" HorizontalAlignment="Center">
                    <TextBlock Text="🎓" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="مرحباً بك في EduMaster" Style="{StaticResource EduHeroTitle}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="منصة موحدة لإدارة العمل الأكاديمي والإداري والمالي" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,24"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#F7F9FC" CornerRadius="10" Padding="18" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="👥" FontSize="23"/>
                            <TextBlock Text="إدارة الأشخاص" Style="{StaticResource EduBodyStrong}" Margin="0,8,0,0"/>
                            <TextBlock Text="الطلاب والأساتذة والموظفون" Style="{StaticResource EduCaption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#F7F9FC" CornerRadius="10" Padding="18" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="📚" FontSize="23"/>
                            <TextBlock Text="العمل الأكاديمي" Style="{StaticResource EduBodyStrong}" Margin="0,8,0,0"/>
                            <TextBlock Text="الأفواج والجداول والحصص" Style="{StaticResource EduCaption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#F7F9FC" CornerRadius="10" Padding="18" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="📊" FontSize="23"/>
                            <TextBlock Text="المتابعة المالية" Style="{StaticResource EduBodyStrong}" Margin="0,8,0,0"/>
                            <TextBlock Text="المالية والأجور والتقارير" Style="{StaticResource EduCaption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Background="#EEF5FC" BorderBrush="#D5E5F4" BorderThickness="1" CornerRadius="9" Padding="14,10" Margin="0,20,0,0">
                    <TextBlock Text="اختر وجهتك من القائمة الجانبية للبدء" Style="{StaticResource EduBodyStrong}" Foreground="{StaticResource AccentDarkBrush}" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>