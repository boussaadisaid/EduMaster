<UserControl x:Class="EduMaster.UI.Expenses.ExpenseEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Width="620" Height="600">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="22,20,22,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource EduSectionTitle}"/>
            <TextBlock Text="بيانات المصروف" Style="{StaticResource EduBodyMuted}" Margin="0,3,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Padding="22,0,22,10">
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock Text="السنة الدراسية *" Style="{StaticResource EduFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding AcademicYears}" SelectedItem="{Binding SelectedYear}" DisplayMemberPath="Name" Height="40" Margin="0,0,0,14"/>
                    <TextBlock Text="الفئة *" Style="{StaticResource EduFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Height="40" Margin="0,0,0,14"/>
                    <TextBlock Text="تاريخ المصروف *" Style="{StaticResource EduFieldLabel}"/>
                    <DatePicker SelectedDate="{Binding ExpenseDate}" Height="40" Margin="0,0,0,14"/>
                    <TextBlock Text="المبلغ بالدينار *" Style="{StaticResource EduFieldLabel}"/>
                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6" Margin="0,0,0,14"/>
                    <TextBlock Text="الملاحظة" Style="{StaticResource EduFieldLabel}"/>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Height="90" Padding="10,6" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                    <Button Content="حفظ" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
