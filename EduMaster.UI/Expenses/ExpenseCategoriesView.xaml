<UserControl x:Class="EduMaster.UI.Expenses.ExpenseCategoriesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="650" Height="570">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="22,20,22,14">
            <StackPanel>
                <TextBlock Text="فئات المصاريف" Style="{StaticResource EduSectionTitle}"/>
                <TextBlock Text="إدارة التصنيفات المستخدمة في المصاريف التشغيلية" Style="{StaticResource EduBodyMuted}" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" Padding="22,0">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                    <Grid MinHeight="250">
                        <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="44" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الفئة" Binding="{Binding Name}" Width="*"/>
                                <DataGridTemplateColumn Header="الحالة" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EduBodyStrong}">
                                                        <Setter Property="Text" Value="معطّلة"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="فعّالة"/>
                                                                <Setter Property="Foreground" Value="{StaticResource PositiveBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="إجراء" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="تعديل" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" Padding="9,4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="لا توجد فئات مصاريف بعد" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="اسم الفئة" Style="{StaticResource EduFieldLabel}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="حفظ" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="0,0,8,0"/>
                            <Button Content="تفعيل / تعطيل المحدد" Command="{Binding ToggleCommand}" Style="{StaticResource SecondaryButton}" Padding="14,7"/>
                        </StackPanel>
                        <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Button Content="إغلاق" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" Padding="16,8" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</UserControl>
