<UserControl x:Class="EduMaster.UI.Billing.PaymentDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- المحتوى: مسقوف بمرور داخلي (D-82) -->
            <RowDefinition Height="Auto"/>
            <!-- التذييل: مثبّت دائماً (D-41) -->
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="540">
            <StackPanel MinWidth="560">

                <TextBlock Text="{Binding ContextText}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="المبلغ (دج) *" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="تاريخ القبض" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding PaidOn}"/>
                    </StackPanel>
                </Grid>

                <CheckBox Content="{Binding GuardianOptionText}" IsChecked="{Binding PaidByGuardian}"
                          Margin="0,10,0,0"
                          Visibility="{Binding ShowGuardianOption, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Text="ملاحظة (اختياري)" Margin="0,10,0,4"/>
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{Binding CreditText}" Foreground="#107C10" FontWeight="SemiBold" TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="{Binding HasCredit, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Text="يُخصَّص على المستحقات المفتوحة (اقتراح تلقائي — الأقدم أولاً · عدّله كما تشاء):"
                           FontWeight="SemiBold" Margin="0,12,0,6"
                           Visibility="{Binding HasOpenCharges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <DataGrid ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          MaxHeight="200"
                          Visibility="{Binding HasOpenCharges, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المستحق" Binding="{Binding SourceText}" Width="2*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding KindText}" Width="Auto" IsReadOnly="True"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingText}" Width="Auto" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="يُخصَّص (دج)" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding AllocatedText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0,0,0,1" Padding="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="لا مستحقات مفتوحة لهذا الطالب — ستُسجَّل الدفعة كلها زائدة دائنة (D-107)"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding NoOpenCharges, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Text="{Binding UnallocatedFromThisText}" Foreground="#B26B00" TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="{Binding HasUnallocatedFromThis, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- التذييل المثبّت: البانر + الأزرار -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="💵 تثبيت القبض" Command="{Binding SaveCommand}" Padding="22,8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>