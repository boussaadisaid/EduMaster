<UserControl x:Class="EduMaster.UI.Billing.Tabs.PaymentsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Border Style="{StaticResource Card}"
            Padding="0">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- رأس التبويب -->
            <Border Padding="16,12"
                    Background="#FAFBFD"
                    BorderBrush="#E8EDF3"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="سجل المدفوعات"
                                   Style="{StaticResource EduSubsectionTitle}"/>

                        <TextBlock Text="{Binding LogSummaryText}"
                                   Style="{StaticResource EduCaption}"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                        <TextBlock Text="من"
                                   Style="{StaticResource EduFieldLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <DatePicker SelectedDate="{Binding FromDate}"
                                    Width="125"
                                    Height="38"/>

                        <TextBlock Text="إلى"
                                   Style="{StaticResource EduFieldLabel}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,6,0"/>

                        <DatePicker SelectedDate="{Binding ToDate}"
                                    Width="125"
                                    Height="38"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- سجل المدفوعات -->
            <Grid Grid.Row="1">

                <DataGrid ItemsSource="{Binding Payments}"
                          SelectedItem="{Binding SelectedPayment}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDF1F6"
                          VerticalGridLinesBrush="Transparent"
                          BorderThickness="0"
                          RowHeight="45"
                          ColumnHeaderHeight="38">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="الإيصال"
                                            Binding="{Binding ReceiptNoText}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="التاريخ"
                                            Binding="{Binding PaidOn, StringFormat='yyyy-MM-dd'}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="الطالب"
                                            Binding="{Binding StudentName}"
                                            Width="1.4*"/>

                        <DataGridTextColumn Header="الدافع"
                                            Binding="{Binding PayerName, TargetNullValue='—'}"
                                            Width="*"/>

                        <DataGridTextColumn Header="النوع"
                                            Binding="{Binding KindText}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="المبلغ"
                                            Binding="{Binding AmountCentimes, Converter={StaticResource CentimesToDinarsConverter}}"
                                            Width="Auto"/>

                        <DataGridTemplateColumn Header="غير مخصص"
                                                Width="Auto">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock Text="{Binding UnallocatedCentimes, Converter={StaticResource CentimesToDinarsConverter}}">

                                        <TextBlock.Style>

                                            <Style TargetType="TextBlock">

                                                <Setter Property="Foreground"
                                                        Value="{StaticResource TextMutedBrush}"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding HasUnallocated}"
                                                                 Value="True">

                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource WarningBrush}"/>

                                                        <Setter Property="FontWeight"
                                                                Value="SemiBold"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ملاحظة"
                                            Binding="{Binding Note, TargetNullValue='—'}"
                                            Width="*"/>

                        <DataGridTemplateColumn Header="الإجراءات"
                                                Width="Auto">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal">

                                        <Button Content="🖨"
                                                ToolTip="طباعة الإيصال"
                                                Padding="8,3"
                                                Command="{Binding DataContext.PrintReceiptCommand,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"/>

                                        <Button Content="↩"
                                                ToolTip="عكس إيصال القبض"
                                                Padding="8,3"
                                                Margin="5,0,0,0"
                                                Command="{Binding DataContext.ReverseReceiptCommand,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}">

                                            <Button.Style>

                                                <Style TargetType="Button">

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsReceipt}"
                                                                     Value="False">

                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Style>

                                        </Button>

                                    </StackPanel>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

                <!-- الحالة الفارغة -->
                <TextBlock Text="لا مدفوعات في هذه الفترة"
                           Style="{StaticResource EduBodyMuted}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding PaymentsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- التحميل -->
                <Border Background="#CCFFFFFF"
                        Visibility="{Binding IsLoadingPayments, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock Text="جارٍ تحميل السجل…"
                               Style="{StaticResource EduBodyMuted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

            </Grid>

        </Grid>

    </Border>

</UserControl>