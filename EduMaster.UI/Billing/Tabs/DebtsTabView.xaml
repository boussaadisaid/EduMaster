<UserControl x:Class="EduMaster.UI.Billing.Tabs.DebtsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             FlowDirection="RightToLeft">

    <Border Style="{StaticResource Card}"
            Padding="0">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- رأس التبويب -->
            <Border Padding="16,12"
                    Background="#FAFBFD"
                    BorderBrush="#E8EDF3"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="الديون القائمة"
                                   Style="{StaticResource EduSubsectionTitle}"/>

                        <TextBlock Text="الطلاب أصحاب المستحقات غير المغطاة"
                                   Style="{StaticResource EduCaption}"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Controls:TextBoxHelper.Watermark="ابحث بالاسم أو الهاتف…"
                             Height="38"
                             Padding="10,6"
                             Margin="12,0"/>

                    <Border Grid.Column="2"
                            Background="{StaticResource NegativeSoftBrush}"
                            CornerRadius="10"
                            Padding="12,6"
                            VerticalAlignment="Center">

                        <TextBlock Text="{Binding TotalDebtText}"
                                   Foreground="{StaticResource NegativeBrush}"
                                   FontWeight="SemiBold"/>

                    </Border>

                </Grid>

            </Border>

            <!-- جدول الديون -->
            <Grid Grid.Row="1">

                <DataGrid ItemsSource="{Binding Debtors}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDF1F6"
                          VerticalGridLinesBrush="Transparent"
                          BorderThickness="0"
                          RowHeight="44"
                          ColumnHeaderHeight="38">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="الطالب"
                                            Binding="{Binding FullName}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="الهاتف"
                                            Binding="{Binding Phone, TargetNullValue='—'}"
                                            Width="*"/>

                        <DataGridTextColumn Header="المستحقات المفتوحة"
                                            Binding="{Binding OpenChargesCount}"
                                            Width="Auto"/>

                        <DataGridTemplateColumn Header="المتبقي"
                                                Width="Auto">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock Text="{Binding RemainingCentimes, Converter={StaticResource CentimesToDinarsConverter}}"
                                               Foreground="{StaticResource NegativeBrush}"
                                               FontWeight="SemiBold"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

                <!-- الحالة الفارغة -->
                <TextBlock Text="لا ديون قائمة — كل المستحقات مغطاة"
                           Style="{StaticResource EduBodyMuted}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding DebtorsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- التحميل -->
                <Border Background="#CCFFFFFF"
                        Visibility="{Binding IsLoadingDebtors, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock Text="جارٍ تحميل الديون…"
                               Style="{StaticResource EduBodyMuted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

            </Grid>

        </Grid>

    </Border>

</UserControl>