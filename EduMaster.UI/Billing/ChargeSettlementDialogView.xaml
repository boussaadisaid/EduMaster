<UserControl x:Class="EduMaster.UI.Billing.ChargeSettlementDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="560" MaxHeight="470">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="22,20,22,16">
            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource WarningSoftBrush}" Margin="0,0,12,0">
                <TextBlock Text="⚖" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource EduSectionTitle}"/>
                <TextBlock Text="تسوية مالية موثقة دون حذف أو تعديل صامت" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,10">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="المستحق المحدد" Style="{StaticResource EduCaption}"/>
                        <TextBlock Text="{Binding ContextText}" Style="{StaticResource EduBodyStrong}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <StackPanel Visibility="{Binding ShowAmountField, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Background="#F7F9FC" CornerRadius="8" Padding="12,9" Margin="0,0,0,14">
                                <TextBlock Text="{Binding CurrentAmountText, StringFormat='المبلغ الحالي: {0}'}" Style="{StaticResource EduBodyStrong}"/>
                            </Border>
                            <TextBlock Text="المبلغ الجديد (دج) *" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding NewAmountText, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6" Width="180" HorizontalAlignment="Right"/>
                            <TextBlock Text="يجب أن يكون أقل من الحالي. تركه فارغاً يعني إعفاءً كاملاً." Style="{StaticResource EduCaption}" Margin="0,6,0,14"/>
                        </StackPanel>
                        <TextBlock Text="سبب التسوية *" Style="{StaticResource EduFieldLabel}"/>
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        <Border Background="#EEF5FC" BorderBrush="#D5E5F4" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,14,0,0">
                            <TextBlock Text="يحفظ السبب مع العملية في السجل المالي، ويبقى المبلغ الأصلي متاحاً للتدقيق." Style="{StaticResource EduCaption}" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="تثبيت التسوية" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="20,9" Margin="0,0,8,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Padding="20,9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>