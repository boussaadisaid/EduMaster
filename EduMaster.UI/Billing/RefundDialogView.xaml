<UserControl x:Class="EduMaster.UI.Billing.RefundDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="560" MaxHeight="470">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="22,20,22,16">
            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource WarningSoftBrush}" Margin="0,0,12,0">
                <TextBlock Text="↩" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="استرجاع نقدي" Style="{StaticResource EduSectionTitle}"/>
                <TextBlock Text="إصدار إيصال صرف من الزائدة الدائنة" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,10">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding ContextText}" Style="{StaticResource EduBodyStrong}"/>
                        <Border Background="{StaticResource PositiveSoftBrush}" CornerRadius="8" Padding="12,9" Margin="0,10,0,0">
                            <TextBlock Text="{Binding CreditText}" Foreground="{StaticResource PositiveBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="بيانات الاسترجاع" Style="{StaticResource EduSubsectionTitle}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,14">
                                <TextBlock Text="المبلغ المسترجع (دج) *" Style="{StaticResource EduFieldLabel}"/>
                                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,14">
                                <TextBlock Text="تاريخ الصرف *" Style="{StaticResource EduFieldLabel}"/>
                                <DatePicker SelectedDate="{Binding PaidOn}" Height="40"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="الحساب المالي *" Style="{StaticResource EduFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding TreasuryAccounts}" SelectedItem="{Binding SelectedTreasuryAccount}" DisplayMemberPath="Name" Height="40" Margin="0,0,0,12"/>
                        <TextBlock Text="سبب الاسترجاع *" Style="{StaticResource EduFieldLabel}"/>
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        <TextBlock Text="يسجل الاسترجاع إيصال صرف موثقاً وينقص الزائدة الدائنة فوراً." Style="{StaticResource EduCaption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="تثبيت الاسترجاع" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="20,9" Margin="0,0,8,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Padding="20,9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>