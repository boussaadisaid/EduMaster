<UserControl x:Class="EduMaster.UI.Billing.RefundDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="380">
            <StackPanel MinWidth="420">
                <TextBlock Text="{Binding ContextText}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding CreditText}" Foreground="#107C10" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="المبلغ المسترجَع (دج) *" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="تاريخ الصرف" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding PaidOn}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="سبب الاسترجاع *" Margin="0,10,0,4"/>
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="الاسترجاع يُسجَّل إيصال صرف بنفس السلسلة المتسلسلة (D-105/D-108) — وينقص الزائدة الدائنة فوراً"
                           Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="↩ تثبيت الاسترجاع" Command="{Binding SaveCommand}" Padding="22,8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>