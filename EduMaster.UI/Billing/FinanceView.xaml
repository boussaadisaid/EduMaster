<UserControl x:Class="EduMaster.UI.Billing.FinanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             FlowDirection="RightToLeft">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <Button Content="🔄 تحديث" Command="{Binding RefreshCommand}"
                    DockPanel.Dock="Left" Padding="14,8"/>
            <TextBlock Text="💰 المالية" FontSize="24" FontWeight="SemiBold"/>
        </DockPanel>

        <!-- قسم الديون -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{Binding TotalDebtText}" DockPanel.Dock="Left" Foreground="#C42B1C"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="من عليهم ديون (المتبقي > 0)" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Controls:TextBoxHelper.Watermark="🔍 بالاسم أو الهاتف…"
                     Width="220" Padding="8,5" Margin="14,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Debtors}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الطالب" Binding="{Binding FullName}" Width="2*"/>
                <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone, TargetNullValue='—'}" Width="*"/>
                <DataGridTextColumn Header="المستحقات المفتوحة" Binding="{Binding OpenChargesCount}" Width="Auto"/>
                <DataGridTemplateColumn Header="المتبقي عليه" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RemainingCentimes, Converter={StaticResource CentimesToDinarsConverter}}"
                                       Foreground="#C42B1C" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="لا ديون قائمة — كل المستحقات مغطاة 🎉"
                   Foreground="Gray" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding DebtorsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <TextBlock Grid.Row="2" Text="جارٍ التحميل…" Foreground="Gray"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsLoadingDebtors, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- قسم سجل المدفوعات -->
        <DockPanel Grid.Row="3" Margin="0,14,0,8">
            <TextBlock Text="{Binding LogSummaryText}" DockPanel.Dock="Left" Foreground="Gray" VerticalAlignment="Center"/>
            <TextBlock Text="سجل المدفوعات" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="120"/>
                <TextBlock Text="إلى" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="120"/>
            </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Payments}"
                  SelectedItem="{Binding SelectedPayment}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="إيصال" Binding="{Binding ReceiptNoText}" Width="Auto"/>
                <DataGridTextColumn Header="التاريخ" Binding="{Binding PaidOn, StringFormat='yyyy-MM-dd'}" Width="Auto"/>
                <DataGridTextColumn Header="الطالب" Binding="{Binding StudentName}" Width="2*"/>
                <DataGridTextColumn Header="الدافع" Binding="{Binding PayerName, TargetNullValue='—'}" Width="*"/>
                <DataGridTemplateColumn Header="النوع" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding KindText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KindText}" Value="صرف">
                                                <Setter Property="Foreground" Value="#B26B00"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                <DataGridTemplateColumn Header="غير مخصص" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding UnallocatedCentimes, Converter={StaticResource CentimesToDinarsConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Gray"/>
                                        <Style.Triggers>
                                            <!-- الزائدة الدائنة ظاهرة بالبرتقالي — خارجة من حبس الديالوغ -->
                                            <DataTrigger Binding="{Binding HasUnallocated}" Value="True">
                                                <Setter Property="Foreground" Value="#B26B00"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ملاحظة" Binding="{Binding Note, TargetNullValue='—'}" Width="*"/>
                <!-- 6.3 (ط-هـ): 🖨 على السطر — إعادة طباعة دائمة (الإيصال وثيقة D-105) · الأمر بالتحديد لا بالمعاملات -->
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🖨" ToolTip="طباعة الإيصال" Padding="8,2" VerticalAlignment="Center"
                                    Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="لا مدفوعات في هذه الفترة"
                   Foreground="Gray" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding PaymentsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <TextBlock Grid.Row="4" Text="جارٍ التحميل…" Foreground="Gray"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsLoadingPayments, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
