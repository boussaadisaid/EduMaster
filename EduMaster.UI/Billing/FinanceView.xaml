<UserControl x:Class="EduMaster.UI.Billing.FinanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls" FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0.42*"/>
            <RowDefinition Height="0.58*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="المالية" Style="{StaticResource EduPageTitle}"/>
                <TextBlock Text="متابعة الديون وسجل القبض والصرف والإيصالات" Style="{StaticResource EduBodyMuted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="↻  تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Padding="16,12" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="الديون القائمة" Style="{StaticResource EduSubsectionTitle}"/>
                            <TextBlock Text="الطلاب أصحاب المستحقات غير المغطاة" Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Controls:TextBoxHelper.Watermark="ابحث بالاسم أو الهاتف…" Height="38" Padding="10,6" Margin="12,0"/>
                        <Border Grid.Column="2" Background="{StaticResource NegativeSoftBrush}" CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalDebtText}" Foreground="{StaticResource NegativeBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Debtors}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" VerticalGridLinesBrush="Transparent" BorderThickness="0" RowHeight="44" ColumnHeaderHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الطالب" Binding="{Binding FullName}" Width="2*"/>
                            <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone, TargetNullValue='—'}" Width="*"/>
                            <DataGridTextColumn Header="المستحقات المفتوحة" Binding="{Binding OpenChargesCount}" Width="Auto"/>
                            <DataGridTemplateColumn Header="المتبقي" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RemainingCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Foreground="{StaticResource NegativeBrush}" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="لا ديون قائمة — كل المستحقات مغطاة" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding DebtorsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Border Background="#CCFFFFFF" Visibility="{Binding IsLoadingDebtors, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="جارٍ تحميل الديون…" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Padding="16,12" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="سجل المدفوعات" Style="{StaticResource EduSubsectionTitle}"/>
                            <TextBlock Text="{Binding LogSummaryText}" Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="من" Style="{StaticResource EduFieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker SelectedDate="{Binding FromDate}" Width="125" Height="38"/>
                            <TextBlock Text="إلى" Style="{StaticResource EduFieldLabel}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                            <DatePicker SelectedDate="{Binding ToDate}" Width="125" Height="38"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" VerticalGridLinesBrush="Transparent" BorderThickness="0" RowHeight="45" ColumnHeaderHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الإيصال" Binding="{Binding ReceiptNoText}" Width="Auto"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding PaidOn, StringFormat='yyyy-MM-dd'}" Width="Auto"/>
                            <DataGridTextColumn Header="الطالب" Binding="{Binding StudentName}" Width="1.4*"/>
                            <DataGridTextColumn Header="الدافع" Binding="{Binding PayerName, TargetNullValue='—'}" Width="*"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding KindText}" Width="Auto"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Width="Auto"/>
                            <DataGridTemplateColumn Header="غير مخصص" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UnallocatedCentimes, Converter={StaticResource CentimesToDinarsConverter}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUnallocated}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style></TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ملاحظة" Binding="{Binding Note, TargetNullValue='—'}" Width="*"/>
                            <DataGridTemplateColumn Header="الإجراءات" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🖨" ToolTip="طباعة الإيصال" Padding="8,3" Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            <Button Content="↩" ToolTip="عكس إيصال القبض" Padding="8,3" Margin="5,0,0,0" Command="{Binding DataContext.ReverseReceiptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReceipt}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="لا مدفوعات في هذه الفترة" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PaymentsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Border Background="#CCFFFFFF" Visibility="{Binding IsLoadingPayments, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="جارٍ تحميل السجل…" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>