<Window x:Class="EduMaster.UI.AcademicYears.Dialogs.CreateUpdateAcademicYearDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EduMaster.UI.AcademicYears.Dialogs"
        mc:Ignorable="d"
        Title="CreateUpdateAcademicYearDialog" Height="250" Width="400" FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!--Dialog title-->
        <TextBlock Grid.ColumnSpan="2"
                   HorizontalAlignment="Center"
                   Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

        <!--Year name-->
        <TextBlock Grid.Row ="1"           
           Text="السنة الدراسية:"/>

        <TextBox Grid.Column="1" Grid.Row="1"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <!--Start date-->
        <TextBlock Grid.Row ="2"           
            Text="تاريخ بداية السنة:"/>

        <DatePicker Grid.Column="1" Grid.Row="2"
          Text="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"/>

        <!--End date-->
        <TextBlock Grid.Row ="3"           
            Text="تاريخ نهاية السنة:"/>

        <DatePicker Grid.Column="1" Grid.Row="3"
            Text="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"/>

        <!--Buttons-->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Grid.ColumnSpan="2">
            <Button Content="حفظ" Command="{Binding SaveCommand}"/>
            <Button Content="إلغاء" Command="{Binding CancelCommand}"/>
        </StackPanel>

    </Grid>
</Window>
