<UserControl x:Class="EduMaster.UI.AcademicYears.AcademicYearsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="السنوات الدراسية" Style="{StaticResource EduPageTitle}"/>
                <TextBlock Text="إدارة الفترات الأكاديمية والسنة الحالية والترحيل الجماعي" Style="{StaticResource EduBodyMuted}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="↻  تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="＋  سنة جديدة" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource PositiveSoftBrush}" BorderBrush="#B7DFB7" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="21" Background="White" Margin="0,0,11,0">
                    <TextBlock Text="★" FontSize="19" Foreground="{StaticResource PositiveBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="السنة الحالية" Style="{StaticResource EduCaption}" Foreground="{StaticResource PositiveBrush}"/>
                    <TextBlock Text="{Binding CurrentYearName}" Style="{StaticResource EduBodyStrong}" Foreground="{StaticResource PositiveBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Padding="16,12" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                    <StackPanel>
                        <TextBlock Text="سجل السنوات" Style="{StaticResource EduSubsectionTitle}"/>
                        <TextBlock Text="حدد سنة لتنفيذ الإجراء المناسب" Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" VerticalGridLinesBrush="Transparent" BorderThickness="0" RowHeight="52" ColumnHeaderHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="السنة" Binding="{Binding Name}" Width="1.4*"/>
                            <DataGridTextColumn Header="تاريخ البداية" Binding="{Binding StartDate, StringFormat=yyyy-MM-dd}" Width="*"/>
                            <DataGridTextColumn Header="تاريخ النهاية" Binding="{Binding EndDate, StringFormat=yyyy-MM-dd}" Width="*"/>
                            <DataGridTemplateColumn Header="الحالة" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EEF5FC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource PositiveSoftBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#EEF1F5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="فعّالة"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Text" Value="★ الحالية"/>
                                                                <Setter Property="Foreground" Value="{StaticResource PositiveBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="معطّلة"/>
                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style></TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="📅" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="لا توجد سنوات دراسية" Style="{StaticResource EduBodyStrong}" Margin="0,7,0,0"/>
                        <TextBlock Text="أنشئ أول سنة للبدء" Style="{StaticResource EduCaption}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Background="#CCFFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="جارٍ التحميل…" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <Border Grid.Row="2" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="14,11">
                    <WrapPanel>
                        <Button Content="تعيين كحالية" Command="{Binding SetCurrentCommand}" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="تعديل" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="تعطيل" Command="{Binding DeactivateCommand}" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="تفعيل" Command="{Binding ActivateCommand}" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="ترحيل جماعي" Command="{Binding RolloverCommand}" Style="{StaticResource SecondaryButton}" Padding="14,7"/>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>