<UserControl x:Class="EduMaster.UI.AcademicYears.AcademicYearEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="560" MaxHeight="500">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="22,20,22,16">
            <Border Width="48" Height="48" CornerRadius="24" Background="#EAF3FC" Margin="0,0,12,0">
                <TextBlock Text="📅" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource EduSectionTitle}"/>
                <TextBlock Text="تحديد الفترة وحقوق التسجيل الافتراضية" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,10">
            <StackPanel>
                <Border Background="#EAF3FC" BorderBrush="#D5E5F4" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="اسم السنة المشتق" Style="{StaticResource EduCaption}"/>
                        <TextBlock Text="{Binding DerivedName}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="فترة السنة الدراسية" Style="{StaticResource EduSubsectionTitle}" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,14">
                                <TextBlock Text="تاريخ البداية *" Style="{StaticResource EduFieldLabel}"/>
                                <DatePicker SelectedDate="{Binding StartDate}" Height="40"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,14">
                                <TextBlock Text="تاريخ النهاية *" Style="{StaticResource EduFieldLabel}"/>
                                <DatePicker SelectedDate="{Binding EndDate}" Height="40"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="حقوق التسجيل الافتراضية (دج)" Style="{StaticResource EduFieldLabel}"/>
                        <TextBox Text="{Binding RegistrationFeeText, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        <TextBlock Text="تُقترح هذه الحقوق عند التسجيل السنوي، ويمكن تعديلها لكل طالب. الحقل الفارغ يعني بلا حقوق." Style="{StaticResource EduCaption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="حفظ" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="20,9" Margin="0,0,8,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Padding="20,9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>