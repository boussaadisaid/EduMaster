<UserControl x:Class="EduMaster.UI.AcademicYears.AcademicYearEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <StackPanel Margin="24" MinWidth="400">

        <!-- المعاينة الحية: الاسم مشتق من التاريخين -->
        <Border Background="#F0F4FF" BorderBrush="#C7D4F5" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="السنة الدراسية: " FontSize="16"/>
                <TextBlock Text="{Binding DerivedName}" FontSize="16" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <TextBlock Text="تاريخ البداية" Margin="0,0,0,4"/>
        <DatePicker SelectedDate="{Binding StartDate}" Margin="0,0,0,12"/>

        <TextBlock Text="تاريخ النهاية" Margin="0,0,0,4"/>
        <DatePicker SelectedDate="{Binding EndDate}" Margin="0,0,0,12"/>

        <!-- D-66: حقوق التسجيل الافتراضية — بالدينار (D-51) · الفارغ = بلا حقوق -->
        <TextBlock Text="حقوق التسجيل الافتراضية (دج)" Margin="0,0,0,4"/>
        <TextBox Text="{Binding RegistrationFeeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

        <!-- بانر الخطأ المتوقع (D-22) -->
        <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                Padding="10,8" Margin="0,0,0,12"
                Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="💾 حفظ" Command="{Binding SaveCommand}" Padding="20,7" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Command="{Binding CancelCommand}" Padding="20,7"/>
        </StackPanel>
    </StackPanel>
</UserControl>