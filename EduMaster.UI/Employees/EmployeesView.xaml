<UserControl x:Class="EduMaster.UI.Employees.EmployeesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        FlowDirection="RightToLeft">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- العمود الأيمن: قائمة الموظفين -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,14">
                <Button Content="➕ موظف جديد" Command="{Binding AddCommand}"
                        DockPanel.Dock="Left" Padding="18,8" FontWeight="SemiBold"/>
                <TextBlock Text="الموظفون" FontSize="24" FontWeight="SemiBold"/>
            </DockPanel>

            <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Controls:TextBoxHelper.Watermark="🔍 ابحث بالاسم أو الهاتف أو الوظيفة…"
                     Padding="10,8" Margin="0,0,0,14"/>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Employees}"
                      SelectedItem="{Binding SelectedEmployee}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="2*"/>
                    <DataGridTextColumn Header="الوظيفة" Binding="{Binding JobTitle}" Width="*"/>
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="*"/>
                    <DataGridTemplateColumn Header="الحالة" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="فعّال"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Text" Value="معطّل"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="لا يوجد موظفون بعد — اضغط «موظف جديد» لإضافة أول موظف"
                       Foreground="Gray" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Grid.Row="2" Text="جارٍ التحميل…" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- ب-6: لا تعطيل هنا — على الشخص من شاشة الأشخاص (D-31) -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="✏️ تعديل"        Command="{Binding EditCommand}"       Padding="14,6" Margin="0,0,8,0"/>
                <Button Content="💼 الأجر"        Command="{Binding OpenPayPolicyCommand}" Padding="14,6" Margin="0,0,8,0"/>
                <Button Content="🗑 إزالة الملف"  Command="{Binding RemoveFileCommand}" Padding="14,6"/>
            </StackPanel>
        </Grid>

        <!-- العمود الأيسر: لوحة سجل أيام العمل (B-3 — مرآة لوحة الطالب D-70) -->
        <Border Grid.Column="1" Margin="16,0,0,0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding SelectedEmployee.FullName, StringFormat='🗓 سجل أيام العمل: {0}', TargetNullValue='🗓 سجل أيام العمل'}"
                           FontWeight="SemiBold" FontSize="15"/>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <!-- ب-3+: بوّابة الشهري الثابت — تنبيه + تعطيل المدخلات -->
                    <TextBlock Text="أجر شهري ثابت — تسجيل الأيام لا يدخل في الاحتساب (D-113)"
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding IsMonthlyPolicy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <StackPanel IsEnabled="{Binding CanLogWorkDays}">
                        <TextBlock Text="التاريخ *" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding NewWorkDate}"/>
                        <TextBlock Text="ملاحظة (اختيارية)" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding NewWorkNote, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="➕ سجّل اليوم" Command="{Binding AddWorkDayCommand}"
                                Padding="12,6" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>

                <DataGrid Grid.Row="2" Margin="0,12,0,0"
                          ItemsSource="{Binding WorkLog}"
                          SelectedItem="{Binding SelectedWorkLog}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding DateText}" Width="Auto"/>
                        <DataGridTextColumn Header="الملاحظة" Binding="{Binding NoteText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Text="اختر موظفاً من القائمة لعرض سجل عمله"
                           Foreground="Gray" FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding NoEmployeeSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="2" Text="لا أيام مسجلة بعد — سجّل أول يوم من الأعلى"
                           Foreground="Gray" FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding WorkLogEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="🗑 احذف المحدد" Command="{Binding RemoveWorkDayCommand}" Padding="12,6"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="التصحيح = حذف اليوم ثم إعادة تسجيله (لا تعديل — D-115)"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>