<UserControl x:Class="EduMaster.UI.People.PersonEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MinWidth="440">

            <TextBlock Text="الاسم الأول *" Margin="0,0,0,4"/>
            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="اللقب *" Margin="0,0,0,4"/>
            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="اسم الأب" Margin="0,0,0,4"/>
            <TextBox Text="{Binding FatherName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="تاريخ الميلاد" Margin="0,0,0,4"/>
            <DatePicker SelectedDate="{Binding BirthDate}" Margin="0,0,0,10"/>

            <TextBlock Text="الجنس" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding GenderOptions}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedGender}" Margin="0,0,0,10"/>

            <TextBlock Text="الهاتف" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="هاتف ثانٍ" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Phone2, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="البريد الإلكتروني" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="العنوان" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <!-- ح-6: قناة الصورة جاهزة في كل الطبقات — الواجهة تنتظر شريحة الملفات -->
            <Border Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,12" IsEnabled="False">
                <TextBlock Text="📷 الصورة — قريباً (الشريحة 1.4)" Foreground="Gray"/>
            </Border>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,12"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="💾 حفظ" Command="{Binding SaveCommand}" Padding="20,7" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" Padding="20,7"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>