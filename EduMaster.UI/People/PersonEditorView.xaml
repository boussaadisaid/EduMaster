<UserControl x:Class="EduMaster.UI.People.PersonEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="650" Height="590">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="22,20,22,16">
            <Border Width="48" Height="48" CornerRadius="24" Background="#EAF3FC" Margin="0,0,12,0">
                <TextBlock Text="👤" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource EduSectionTitle}"/>
                <TextBlock Text="سجل شخص مستقل يمكن إسناد الأدوار إليه لاحقاً" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,12">
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock Text="البيانات الشخصية" Style="{StaticResource EduSubsectionTitle}" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,14">
                            <TextBlock Text="الاسم الأول *" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,14">
                            <TextBlock Text="اللقب *" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,14">
                            <TextBlock Text="اسم الأب" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding FatherName, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,14">
                            <TextBlock Text="تاريخ الميلاد" Style="{StaticResource EduFieldLabel}"/>
                            <DatePicker SelectedDate="{Binding BirthDate}" Height="40"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,14">
                            <TextBlock Text="الجنس" Style="{StaticResource EduFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding GenderOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedGender}" Height="40" Padding="8,5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,14">
                            <TextBlock Text="الهاتف" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,14">
                            <TextBlock Text="هاتف ثانٍ" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding Phone2, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,14">
                            <TextBlock Text="البريد الإلكتروني" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="0" Margin="0">
                        <TextBlock Text="العنوان" Style="{StaticResource EduFieldLabel}"/>
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                    </StackPanel>
                    <Border Background="#F7F9FC" CornerRadius="8" Padding="12,9" Margin="0,14,0,0">
                        <TextBlock Text="يمكن إضافة الصورة من ملف الطالب أو الأستاذ أو الموظف بعد إسناد الدور." Style="{StaticResource EduCaption}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="حفظ" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="20,9" Margin="0,0,8,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Padding="20,9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>