<UserControl x:Class="EduMaster.UI.People.ChangePasswordView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="500" Height="430">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,20,22,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,0,2,18">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#EAF3FC" Margin="0,0,12,0">
                        <TextBlock Text="🔐" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="تغيير كلمة المرور" Style="{StaticResource EduSectionTitle}"/>
                        <TextBlock Text="خطوة إلزامية لحماية حسابك" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Background="#EEF5FC" BorderBrush="#D5E5F4" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,14">
                    <TextBlock Text="تستخدم حالياً كلمة مرور مؤقتة. اختر كلمة جديدة للمتابعة إلى النظام." Style="{StaticResource EduCaption}" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap"/>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="كلمة المرور الجديدة *" Style="{StaticResource EduFieldLabel}"/>
                        <PasswordBox x:Name="TxtNew" PasswordChanged="New_Changed" Height="40" Padding="10,6" Margin="0,0,0,14"/>
                        <TextBlock Text="تأكيد كلمة المرور *" Style="{StaticResource EduFieldLabel}"/>
                        <PasswordBox x:Name="TxtConfirm" PasswordChanged="Confirm_Changed" Height="40" Padding="10,6"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <Button Grid.Column="1" Content="تغيير والمتابعة" Command="{Binding ChangeCommand}" Style="{StaticResource PrimaryButton}" Padding="20,9"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>