<UserControl x:Class="EduMaster.UI.People.ChangePasswordView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft">
    <StackPanel Margin="24" MinWidth="400">
        <TextBlock Text="تستخدم كلمة مرور مؤقتة. اختر كلمة جديدة للمتابعة إلى النظام."
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <TextBlock Text="كلمة المرور الجديدة" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TxtNew" PasswordChanged="New_Changed" Margin="0,0,0,10"/>

        <TextBlock Text="تأكيد كلمة المرور" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TxtConfirm" PasswordChanged="Confirm_Changed" Margin="0,0,0,12"/>

        <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                Padding="10,8" Margin="0,0,0,12"
                Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
        </Border>

        <Button Content="🔑 تغيير والمتابعة" Command="{Binding ChangeCommand}"
                Padding="20,7" HorizontalAlignment="Left"/>
    </StackPanel>
</UserControl>