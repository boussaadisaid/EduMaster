<UserControl x:Class="EduMaster.UI.People.CreateAccountView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="520" Height="450">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,20,22,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,0,2,18">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#EAF3FC" Margin="0,0,12,0">
                        <TextBlock Text="🔑" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إنشاء حساب دخول" Style="{StaticResource EduSectionTitle}"/>
                        <TextBlock Text="ربط الشخص بحساب آمن للنظام" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="الشخص" Style="{StaticResource EduFieldLabel}"/>
                        <Border Background="#F7F9FC" CornerRadius="8" Padding="12,9" Margin="0,0,0,16">
                            <TextBlock Text="{Binding PersonName}" Style="{StaticResource EduBodyStrong}"/>
                        </Border>
                        <TextBlock Text="اسم المستخدم *" Style="{StaticResource EduFieldLabel}"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6" Margin="0,0,0,14"/>
                        <TextBlock Text="كلمة المرور المؤقتة *" Style="{StaticResource EduFieldLabel}"/>
                        <PasswordBox x:Name="TxtTempPassword" PasswordChanged="TempPassword_Changed" Height="40" Padding="10,6"/>
                        <TextBlock Text="سيُطلب من المستخدم تغييرها عند أول تسجيل دخول." Style="{StaticResource EduCaption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="إنشاء الحساب" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}" Padding="18,9" Margin="0,0,8,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Padding="18,9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>