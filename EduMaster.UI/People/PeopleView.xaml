<UserControl x:Class="EduMaster.UI.People.PeopleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        FlowDirection="RightToLeft">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- الترويسة -->
        <DockPanel Margin="0,0,0,14">
            <Button Content="➕ شخص جديد" Command="{Binding AddCommand}"
                    DockPanel.Dock="Left" Padding="18,8" FontWeight="SemiBold"/>
            <TextBlock Text="الأشخاص" FontSize="24" FontWeight="SemiBold"/>
        </DockPanel>

        <!-- البحث الفوري -->
        <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Controls:TextBoxHelper.Watermark="🔍 ابحث بالاسم أو الهاتف…"
                 Padding="10,8" Margin="0,0,0,14"/>

        <!-- المحتوى: الشبكة + بطاقة الحساب -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding People}"
                      SelectedItem="{Binding SelectedPerson}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="2*"/>
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="*"/>
                    <DataGridTextColumn Header="هاتف 2" Binding="{Binding Phone2}" Width="*"/>
                    <DataGridTemplateColumn Header="الحالة" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="فعّال"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Text" Value="معطّل"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- بطاقة حساب الدخول للشخص المحدد -->
            <Border Grid.Column="1" Background="#F7F9FC" BorderBrush="#D5DEEA" BorderThickness="1"
                    CornerRadius="6" Padding="14" Margin="12,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="🔑 حساب الدخول" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding AccountStatusText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedAccount.Username, StringFormat='اسم المستخدم: {0}', TargetNullValue=''}"
                               Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="➕ إنشاء حساب" Command="{Binding CreateAccountCommand}" Margin="0,0,0,6"/>
                    <Button Content="🔓 فك القفل" Command="{Binding UnlockAccountCommand}" Margin="0,0,0,6"/>
                    <Button Content="🔁 إعادة تعيين كلمة المرور" Command="{Binding ResetPasswordCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- الحالة الفارغة + التحميل -->
        <TextBlock Grid.Row="2" Text="لا يوجد أشخاص بعد — اضغط «شخص جديد» لإضافة أول شخص"
                   Foreground="Gray" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <TextBlock Grid.Row="2" Text="جارٍ التحميل…" Foreground="Gray"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- شريط الإجراءات على الشخص المحدد -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="✏️ تعديل"  Command="{Binding EditCommand}"       Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="🚫 تعطيل" Command="{Binding DeactivateCommand}" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="✔ تفعيل"  Command="{Binding ActivateCommand}"   Padding="14,6"/>
            <Button Content="🎓 أضف كطالب"   Command="{Binding AssignStudentRoleCommand}" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="👨‍🏫 أضف كأستاذ" Command="{Binding AssignTeacherRoleCommand}" Padding="14,6"/>
        </StackPanel>
    </Grid>
</UserControl>