<UserControl x:Class="EduMaster.UI.People.ResetPasswordView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft">
    <StackPanel Margin="24" MinWidth="400">
        <TextBlock Text="{Binding PersonName, StringFormat='إعادة تعيين كلمة المرور لحساب: {0}'}"
                   FontWeight="SemiBold" Margin="0,0,0,14"/>

        <TextBlock Text="كلمة المرور المؤقتة الجديدة" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TxtNewPassword" PasswordChanged="NewPassword_Changed" Margin="0,0,0,4"/>
        <TextBlock Text="سيُطلب من المستخدم تغييرها عند دخوله المقبل." Foreground="Gray" FontSize="12" Margin="0,0,0,12"/>

        <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                Padding="10,8" Margin="0,0,0,12"
                Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="🔁 إعادة التعيين" Command="{Binding ResetCommand}" Padding="20,7" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Command="{Binding CancelCommand}" Padding="20,7"/>
        </StackPanel>
    </StackPanel>
</UserControl>