<UserControl x:Class="EduMaster.UI.Enrollments.AnnualEnrollmentEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="620" Height="540">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,20,22,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,0,2,18">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#EAF3FC" Margin="0,0,12,0">
                        <TextBlock Text="🎓" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource EduSectionTitle}"/>
                        <TextBlock Text="تسجيل الطالب أكاديمياً في سنة ومستوى وشعبة" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="21" Background="#EEF5FC" Margin="0,0,11,0">
                            <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="الطالب" Style="{StaticResource EduCaption}"/>
                            <TextBlock Text="{Binding StudentName}" Style="{StaticResource EduBodyStrong}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="المسار الدراسي" Style="{StaticResource EduSubsectionTitle}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,14">
                                <TextBlock Text="السنة الدراسية *" Style="{StaticResource EduFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Years}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedYear}" IsEnabled="{Binding IsCreateMode}" Height="40" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,14">
                                <TextBlock Text="المستوى *" Style="{StaticResource EduFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Levels}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedLevel}" Height="40" Padding="10,6"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="الشعبة الاختيارية" Style="{StaticResource EduFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Streams}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedStream}" Height="40" Padding="10,6"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="حقوق التسجيل" Style="{StaticResource EduSubsectionTitle}"/>
                        <TextBlock Text="المبلغ بالدينار" Style="{StaticResource EduFieldLabel}" Margin="0,12,0,0"/>
                        <TextBox Text="{Binding FeeText, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                        <TextBlock Text="يُقترح المبلغ من السنة المختارة، ويبقى قابلاً للتعديل. الصفر أو الحقل الفارغ يعني إعفاء." Style="{StaticResource EduCaption}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <TextBlock Text="ملاحظة الحقوق" Style="{StaticResource EduFieldLabel}"/>
                        <TextBox Text="{Binding FeeNote, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,6"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="حفظ" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="20,9" Margin="0,0,8,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Padding="20,9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>