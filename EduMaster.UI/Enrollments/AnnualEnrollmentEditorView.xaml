<UserControl x:Class="EduMaster.UI.Enrollments.AnnualEnrollmentEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- الحقول: تُمرَّر -->
            <RowDefinition Height="Auto"/>
            <!-- التذييل: مثبّت دائماً (D-41) -->
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel MinWidth="440">

                <TextBlock Text="{Binding StudentName, StringFormat='الطالب: {0}'}"
                           FontWeight="SemiBold" Margin="0,0,0,14"/>

                <!-- صف: السنة | المستوى -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="السنة الدراسية *" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Years}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedYear}"
                                  IsEnabled="{Binding IsCreateMode}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="المستوى *" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Levels}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedLevel}"/>
                    </StackPanel>
                </Grid>

                <!-- صف: الشعبة | حقوق التسجيل -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="الشعبة (اختياري)" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Streams}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedStream}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="حقوق التسجيل (دج)" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FeeText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="الحقوق تُقترح من السنة المختارة وتبقى قابلة للتعديل — 0 أو فارغ = إعفاء (D-52/D-72)"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock Text="ملاحظة الحقوق (اختياري)" Margin="0,0,0,4"/>
                <TextBox Text="{Binding FeeNote, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- التذييل المثبّت: البانر + الأزرار -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="💾 حفظ" Command="{Binding SaveCommand}" Padding="22,8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>