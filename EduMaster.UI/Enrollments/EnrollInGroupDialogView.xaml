<UserControl x:Class="EduMaster.UI.Enrollments.EnrollInGroupDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="820" MaxHeight="650">

    <UserControl.Resources>
        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="InputCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>
        <Style x:Key="ActionPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="20,8"/>
        </Style>
        <Style x:Key="ActionSecondary" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="20,8"/>
        </Style>
        <Style x:Key="ModernGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F6"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="22,20,22,16">
            <Border Width="48" Height="48" CornerRadius="24" Background="#EAF3FC" Margin="0,0,12,0">
                <TextBlock Text="🧑‍🤝‍🧑" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="إلحاق بفوج" Style="{StaticResource EduSectionTitle}"/>
                <TextBlock Text="{Binding StudentName, StringFormat='اختيار فوج مؤهل للطالب {0}'}" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,10">
            <StackPanel>
                <Border Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="التسجيل السنوي" Style="{StaticResource EduSubsectionTitle}"/>
                            <TextBlock Text="{Binding AnnualSummary}" Style="{StaticResource EduBodyMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="إنشاء التسجيل السنوي" Command="{Binding CreateAnnualCommand}" Style="{StaticResource ActionPrimary}" Margin="14,0,0,0" Visibility="{Binding AnnualMissing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SectionCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Padding="16,13" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                            <StackPanel>
                                <TextBlock Text="الأفواج المؤهلة" Style="{StaticResource EduSubsectionTitle}"/>
                                <TextBlock Text="مطابقة السنة والمستوى والشعبة والسعة" Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1">
                            <DataGrid ItemsSource="{Binding EligibleGroups}" SelectedItem="{Binding SelectedGroup}" Style="{StaticResource ModernGrid}" MaxHeight="230">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="الفوج" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource EduBodyStrong}"/>
                                                    <TextBlock Text="{Binding SubjectName}" Style="{StaticResource EduCaption}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="الشعب" Binding="{Binding StreamsDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="الأستاذ" Binding="{Binding TeacherFullName, TargetNullValue='—'}" Width="*"/>
                                    <DataGridTextColumn Header="السنة" Binding="{Binding AcademicYearName}" Width="Auto"/>
                                    <DataGridTextColumn Header="المسجلون" Binding="{Binding EnrolledDisplay}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="لا توجد أفواج مؤهلة حالياً" Style="{StaticResource EduBodyMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding EligibleGroupsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SectionCard}" Visibility="{Binding HasSelectedGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="تفاصيل الإلحاق" Style="{StaticResource EduSubsectionTitle}"/>
                        <Border Background="#EEF5FC" CornerRadius="8" Padding="11,8" Margin="0,8,0,14">
                            <TextBlock Text="{Binding SuggestedPriceText}" Style="{StaticResource EduCaption}" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap"/>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,0">
                                <TextBlock Text="سعر الحصة المتفق (دج)" Style="{StaticResource EduFieldLabel}"/>
                                <TextBox Text="{Binding AgreedPriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0">
                                <TextBlock Text="ملاحظة الخصم" Style="{StaticResource EduFieldLabel}"/>
                                <TextBox Text="{Binding DiscountNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="7,0,0,0">
                                <TextBlock Text="حصص مبدئية" Style="{StaticResource EduFieldLabel}"/>
                                <TextBox Text="{Binding InitialSessionsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="الافتراضي 4 حصص · الصفر يعني الإلحاق دون شراء الآن · يمكنك إلحاق الطالب بأكثر من فوج تباعاً" Style="{StaticResource EduCaption}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="إلحاق بالفوج" Command="{Binding EnrollCommand}" Style="{StaticResource ActionPrimary}" Margin="0,0,8,0"/>
                    <Button Content="إغلاق" Command="{Binding CloseCommand}" Style="{StaticResource ActionSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>