<UserControl x:Class="EduMaster.UI.Enrollments.EnrollInGroupDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- المحتوى: مسقوف بمرور داخلي (D-82) -->
            <RowDefinition Height="Auto"/>
            <!-- التذييل: مثبّت دائماً (D-41) -->
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <StackPanel MinWidth="640">

                <TextBlock Text="{Binding StudentName, StringFormat='الطالب: {0}'}" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="{Binding AnnualSummary}" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,10"/>

                <Button Content="📅 إنشاء التسجيل السنوي أولاً" Command="{Binding CreateAnnualCommand}"
                        Padding="12,6" HorizontalAlignment="Right" Margin="0,0,0,8"
                        Visibility="{Binding AnnualMissing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Text="الأفواج المؤهَّلة له (نفس السنة والمستوى · الشعبة المناسبة · فعّالة · غير ممتلئة):"
                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DataGrid ItemsSource="{Binding EligibleGroups}" SelectedItem="{Binding SelectedGroup}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          MaxHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الفوج" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="المادة" Binding="{Binding SubjectName}" Width="*"/>
                        <DataGridTextColumn Header="الشعب" Binding="{Binding StreamsDisplay}" Width="*"/>
                        <DataGridTextColumn Header="الأستاذ" Binding="{Binding TeacherFullName, TargetNullValue='—'}" Width="*"/>
                        <DataGridTextColumn Header="السنة" Binding="{Binding AcademicYearName}" Width="Auto"/>
                        <DataGridTextColumn Header="المسجَّلون" Binding="{Binding EnrolledDisplay}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="لا أفواج مؤهَّلة حالياً لهذا الطالب" Foreground="Gray" FontSize="13"
                           Margin="0,6,0,0"
                           Visibility="{Binding EligibleGroupsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- السعر — يظهر عند اختيار فوج (D-77) -->
                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding HasSelectedGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SuggestedPriceText}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="سعر الحصة المتفق (دج)" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AgreedPriceText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ملاحظة خصم (اختياري)" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DiscountNote, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="يمكنك إلحاقه بعدة أفواج تباعاً — الديالوغ لا يُغلق بعد كل إلحاق"
                               Foreground="Gray" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- التذييل المثبّت: البانر + الأزرار -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="➕ إلحاق بالفوج" Command="{Binding EnrollCommand}" Padding="22,8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="إغلاق" Command="{Binding CloseCommand}" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>