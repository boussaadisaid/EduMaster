<UserControl x:Class="EduMaster.UI.Enrollments.RolloverDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- المحتوى: مسقوف بمرور داخلي (D-82) -->
            <RowDefinition Height="Auto"/>
            <!-- التذييل: مثبّت دائماً (D-41) -->
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="540">
            <StackPanel MinWidth="820">

                <TextBlock Text="{Binding StepIndicatorText}" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="{Binding TargetHeaderText}" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,10"/>

                <!-- الخطوة 1: المصدر + خريطة الانتقال -->
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="سنة المصدر:" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding SourceYearOptions}" SelectedItem="{Binding SelectedSourceYear}"
                                  DisplayMemberPath="Name" MinWidth="150" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="(الافتراضي: الحالية)" Foreground="Gray" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="خريطة الانتقال — لكل (مستوى + شعبة) في المصدر اختر هدفه:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding MappingRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="من (المصدر)" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SourceLabel}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="إلى مستوى" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding TargetLevels}" DisplayMemberPath="Name" Margin="2"
                                                  SelectedItem="{Binding SelectedTargetLevel, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="إلى شعبة" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding TargetStreams}" DisplayMemberPath="Label" Margin="2"
                                                  SelectedItem="{Binding SelectedTargetStream, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="لا مرشحين في سنة المصدر — لا خريطة تُعرض" Foreground="Gray" FontSize="13" Margin="0,4,0,0"
                               Visibility="{Binding MappingEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="الافتراضي الذكي: نفس المستوى ونفس الشعبة — عدّل صفوف من تقرّ ترقيتهم فقط."
                               Foreground="Gray" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- الخطوة 2: المعاينة بالتحديد -->
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding CountersText}" Foreground="Gray" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✔" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="الطالب" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Candidate.FullName}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="من (المصدر)" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SourceLabel}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="إلى" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TargetLabel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="متبقٍّ عليه" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Candidate.DebtCentimes, Converter={StaticResource CentimesToDinarsConverter}}"
                                                   Foreground="#C42B1C" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="الحالة" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="الدين معلوماتي ولا يمنع الترحيل (تر-5) · المستبعدون يظهرون بأسبابهم ولا يُخفَون (روح D-124)"
                               Foreground="Gray" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- الخطوة 3: تقرير التنفيذ -->
                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ResultSummaryText}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding ResultRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الطالب" Binding="{Binding FullName}" Width="2*"/>
                            <DataGridTemplateColumn Header="النتيجة" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OutcomeText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                            <Setter Property="Foreground" Value="DarkGreen"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                            <Setter Property="Foreground" Value="#C42B1C"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="إعادة التنفيذ آمنة: المسجَّلون في الهدف يُتخطَّون تلقائياً — «↩ دفعة أخرى» تُكمل الفاشلين فقط (روح D-87)."
                               Foreground="Gray" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- التذييل المثبّت: البانر + الأزرار -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FDE7E9" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="▶ تنفيذ الترحيل" Command="{Binding ExecuteCommand}" Padding="18,8" FontWeight="SemiBold"
                        Visibility="{Binding IsStep2, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="↩ دفعة أخرى" Command="{Binding AgainCommand}" Padding="14,8" Margin="8,0,0,0"
                        Visibility="{Binding IsStep3, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="→ رجوع للخريطة" Command="{Binding BackCommand}" Padding="14,8" Margin="8,0,0,0"
                        Visibility="{Binding IsStep2, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="المعاينة ←" Command="{Binding NextCommand}" Padding="18,8" Margin="8,0,0,0"
                        Visibility="{Binding IsStep1, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="إغلاق" Command="{Binding CloseCommand}" Padding="22,8" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>