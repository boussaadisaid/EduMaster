<UserControl x:Class="EduMaster.UI.Enrollments.RolloverDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="820" MaxHeight="680">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="22,20,22,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="50" Height="50" CornerRadius="25" Background="#EAF3FC" Margin="0,0,12,0">
                    <TextBlock Text="↗" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentDarkBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="الترحيل الجماعي" Style="{StaticResource EduSectionTitle}"/>
                    <TextBlock Text="{Binding StepIndicatorText}" Style="{StaticResource EduBodyMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#EEF5FC" CornerRadius="12" Padding="14,7" VerticalAlignment="Center">
                <TextBlock Text="3 خطوات" Style="{StaticResource EduBodyStrong}" Foreground="{StaticResource AccentDarkBrush}"/>
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,10">
            <StackPanel>
                <Border Background="#EEF5FC" BorderBrush="#D5E5F4" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                    <TextBlock Text="{Binding TargetHeaderText}" Style="{StaticResource EduBodyStrong}" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="1. خريطة الانتقال" Style="{StaticResource EduSubsectionTitle}"/>
                            <TextBlock Text="حدد سنة المصدر، ثم وجه كل مستوى وشعبة إلى وجهته في السنة الجديدة." Style="{StaticResource EduCaption}" Margin="0,3,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="سنة المصدر" Style="{StaticResource EduFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding SourceYearOptions}" SelectedItem="{Binding SelectedSourceYear}" DisplayMemberPath="Name" Height="40" Padding="10,6"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="الافتراضي هو السنة الحالية، ويمكن تغييره قبل بناء الخريطة." Style="{StaticResource EduBodyMuted}" VerticalAlignment="Bottom" Margin="14,0,0,10"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="300"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Padding="16,12" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                                <TextBlock Text="المستويات والشعب" Style="{StaticResource EduSubsectionTitle}"/>
                            </Border>
                            <Grid Grid.Row="1">
                                <DataGrid ItemsSource="{Binding MappingRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" VerticalGridLinesBrush="Transparent" BorderThickness="0" RowHeight="48" ColumnHeaderHeight="40">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="من المصدر" Binding="{Binding SourceLabel}" Width="1.3*" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="إلى مستوى" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding TargetLevels}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTargetLevel, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" Margin="4"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="إلى شعبة" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding TargetStreams}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTargetStream, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" Margin="4"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding MappingEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="لا توجد خريطة" Style="{StaticResource EduBodyStrong}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="لا مرشحين في سنة المصدر المحددة" Style="{StaticResource EduBodyMuted}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Background="#F8FAFD" BorderBrush="#E8EDF3" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="14,9">
                                <TextBlock Text="يُقترح نفس المستوى والشعبة تلقائياً. غيّر فقط الصفوف التي تريد ترقيتها." Style="{StaticResource EduCaption}"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="390"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Padding="16,12" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="2. معاينة المرشحين" Style="{StaticResource EduSubsectionTitle}"/>
                                        <TextBlock Text="راجع الوجهة وحدد من سيشمله التنفيذ" Style="{StaticResource EduCaption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#EEF5FC" CornerRadius="10" Padding="12,5">
                                        <TextBlock Text="{Binding CountersText}" Style="{StaticResource EduCaption}" Foreground="{StaticResource AccentDarkBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" VerticalGridLinesBrush="Transparent" BorderThickness="0" RowHeight="46" ColumnHeaderHeight="40">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="اختيار" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="الطالب" Binding="{Binding Candidate.FullName}" Width="1.5*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="من" Binding="{Binding SourceLabel}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="إلى" Binding="{Binding TargetLabel}" Width="*" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="المتبقي" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Candidate.DebtCentimes, Converter={StaticResource CentimesToDinarsConverter}}" Foreground="{StaticResource NegativeBrush}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="1.4*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Background="#F8FAFD" BorderBrush="#E8EDF3" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="14,9">
                                <TextBlock Text="الدين معلوماتي ولا يمنع الترحيل. المستبعدون يبقون ظاهرين مع سبب الاستبعاد." Style="{StaticResource EduCaption}"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="390"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Padding="16,12" Background="#FAFBFD" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="3. تقرير التنفيذ" Style="{StaticResource EduSubsectionTitle}"/>
                                    <TextBlock Text="{Binding ResultSummaryText}" Style="{StaticResource EduBodyStrong}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ResultRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" VerticalGridLinesBrush="Transparent" BorderThickness="0" RowHeight="46" ColumnHeaderHeight="40">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الطالب" Binding="{Binding FullName}" Width="2*"/>
                                    <DataGridTemplateColumn Header="النتيجة" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding OutcomeText}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource PositiveBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource NegativeBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style></TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Background="#F8FAFD" BorderBrush="#E8EDF3" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="14,9">
                                <TextBlock Text="إعادة التنفيذ آمنة؛ التسجيلات الموجودة في سنة الهدف تُتخطى تلقائياً." Style="{StaticResource EduCaption}"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="تنفيذ الترحيل" Command="{Binding ExecuteCommand}" Style="{StaticResource PrimaryButton}" Padding="18,9" Margin="0,0,8,0" Visibility="{Binding IsStep2, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="دفعة أخرى" Command="{Binding AgainCommand}" Style="{StaticResource PrimaryButton}" Padding="18,9" Margin="0,0,8,0" Visibility="{Binding IsStep3, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="رجوع للخريطة" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}" Padding="16,9" Margin="0,0,8,0" Visibility="{Binding IsStep2, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="المعاينة" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}" Padding="18,9" Margin="0,0,8,0" Visibility="{Binding IsStep1, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="إغلاق" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" Padding="18,9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>