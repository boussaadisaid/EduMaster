<UserControl x:Class="EduMaster.UI.Treasury.TreasuryTransferDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="620" MaxHeight="590">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="22,20,22,16">
            <TextBlock Text="تحويل بين الحسابات" Style="{StaticResource EduSectionTitle}"/>
            <TextBlock Text="نقل مبلغ من حساب مالي إلى حساب آخر" Style="{StaticResource EduBodyMuted}" Margin="0,3,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Padding="22,0,22,10">
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,7,14">
                            <TextBlock Text="من الحساب *" Style="{StaticResource EduFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding FromAccount}" DisplayMemberPath="Name" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="7,0,0,14">
                            <TextBlock Text="إلى الحساب *" Style="{StaticResource EduFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding ToAccount}" DisplayMemberPath="Name" Height="40"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,7,14">
                            <TextBlock Text="التاريخ *" Style="{StaticResource EduFieldLabel}"/>
                            <DatePicker SelectedDate="{Binding TransferDate}" Language="ar-DZ" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="7,0,0,14">
                            <TextBlock Text="المبلغ (دج) *" Style="{StaticResource EduFieldLabel}"/>
                            <TextBox Text="{Binding AmountText,UpdateSourceTrigger=PropertyChanged}" Height="40"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="الملاحظة" Style="{StaticResource EduFieldLabel}"/>
                    <TextBox Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}" Height="90" Padding="10,6" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource NegativeSoftBrush}" BorderBrush="#F1B8BE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,14,0" Visibility="{Binding HasErrorMessage,Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                    <Button Content="تنفيذ التحويل" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
