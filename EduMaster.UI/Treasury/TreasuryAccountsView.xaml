<UserControl x:Class="EduMaster.UI.Treasury.TreasuryAccountsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Width="760" Height="560">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="الحسابات المالية" Style="{StaticResource EduPageTitle}" Margin="0,0,0,14"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="44">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الحساب" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="الرصيد الافتتاحي" Binding="{Binding OpeningBalanceCentimes,Converter={StaticResource CentimesToDinarsConverter}}" Width="*"/>
                <DataGridTextColumn Header="الحالة" Binding="{Binding IsActive,Converter={StaticResource BooleanToArabicTextConverter}}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8F0" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="＋ حساب جديد" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                    <Button Content="تعديل" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                    <Button Content="تفعيل / تعطيل" Command="{Binding ToggleCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8"/>
                </StackPanel>
                <Button Grid.Column="1" Content="إغلاق" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" Padding="18,8"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
